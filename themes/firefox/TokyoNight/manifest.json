{
  "manifest_version": 2,
  "name": "Tokyo Night",
  "version": "1.0.0",
  "description": "Tokyo Night for Firefox: dark background, soft text and a muted orange accent.",
  "author": "nikita",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png"
  },
  "theme": {
    "colors": {
      "frame": "#1a1b26",
      "frame_inactive": "#16161e",
      "tab_background_text": "#a9b1d6",
      "tab_background_text_inactive": "#565f89",
      "tab_background_separator": "#292e42",
      "tab_selected": "#24283b",
      "tab_text": "#c0caf5",
      "tab_line": "#7aa2f7",
      "tab_loading": "#7aa2f7",
      "toolbar": "#1a1b26",
      "toolbar_text": "#c0caf5",
      "toolbar_top_separator": "#1a1b26",
      "toolbar_bottom_separator": "#292e42",
      "toolbar_vertical_separator": "#292e42",
      "toolbar_field": "#1f2335",
      "toolbar_field_text": "#c0caf5",
      "toolbar_field_border": "#292e42",
      "toolbar_field_focus": "#24283b",
      "toolbar_field_text_focus": "#c0caf5",
      "toolbar_field_border_focus": "#7aa2f7",
      "toolbar_field_highlight": "#7aa2f7",
      "toolbar_field_highlight_text": "#1a1b26",
      "button_background_hover": "#292e42",
      "button_background_active": "#414868",
      "icons": "#a9b1d6",
      "icons_attention": "#7aa2f7",
      "popup": "#1f2335",
      "popup_text": "#c0caf5",
      "popup_border": "#292e42",
      "popup_highlight": "#414868",
      "popup_highlight_text": "#c0caf5",
      "sidebar": "#16161e",
      "sidebar_text": "#c0caf5",
      "sidebar_border": "#292e42",
      "sidebar_highlight": "#414868",
      "sidebar_highlight_text": "#c0caf5",
      "ntp_background": "#1a1b26",
      "ntp_text": "#c0caf5",
      "ntp_card_background": "#1f2335"
    },
    "properties": {
      "colorScheme": "dark",
      "contentColorScheme": "dark"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tokyo-night@nikita",
      "strict_min_version": "115.0"
    }
  }
}
