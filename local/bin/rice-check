#!/bin/bash
# ==========================================================
# rice-check — Проверка состояния райса и дотфайлов
# ==========================================================
# Запуск: rice-check
# Симлинки на репозиторий, команды и пути из sxhkdrc, bash -n,
# картинки README. Без сети и sudo. 0 — всё в порядке, 1 — проблемы.
# ==========================================================

set -u

SELF=$(readlink -f "$0")
DOTFILES=$(cd "$(dirname "$SELF")/../.." && pwd)
cd "$DOTFILES" || exit 1

fail=0
bad() { printf 'FAIL  %s\n' "$*"; fail=1; }

# --- Симлинки: репозиторий -> живая система ---
check_link() {
    local live=$1 want=$2 real
    if [ ! -L "$live" ]; then
        bad "$live: нет симлинка (запусти ./scripts/link.sh)"
        return
    fi
    real=$(readlink -f "$live")
    case "$real" in
        "$want")       ;;
        "$DOTFILES"/*) bad "$live: ведёт на $real вместо $want" ;;
        *)             bad "$live: ведёт вне репозитория ($real)" ;;
    esac
}

for dir in config/*/; do
    pkg=$(basename "$dir")
    check_link "$HOME/.config/$pkg" "$DOTFILES/config/$pkg"
done
for file in home/*; do
    name=$(basename "$file")
    check_link "$HOME/.$name" "$DOTFILES/$file"
done
for file in local/bin/*; do
    # Документация живёт в docs/: на случай старых .md — пропускаем.
    case $file in *.md) continue ;; esac
    check_link "$HOME/.local/bin/$(basename "$file")" "$DOTFILES/$file"
done
for file in local/share/mc/skins/*.ini; do
    check_link "$HOME/.local/share/mc/skins/$(basename "$file")" "$DOTFILES/$file"
done

# --- Команды и пути, на которые ссылается sxhkdrc ---
for cmd in $(grep -oP '^\s{4}\K[^\s]+' config/sxhkd/sxhkdrc | grep -vE '^(~|\$|/|\.)' | sort -u); do
    command -v "$cmd" >/dev/null 2>&1 || bad "нет команды: $cmd"
done
for path in $(grep -oP '^\s{4}\K~/\S+' config/sxhkd/sxhkdrc | sort -u); do
    [ -x "${path/#\~/$HOME}" ] || bad "нет файла: $path"
done

# --- Шпаргалки: каждая комбинация из конфигов должна быть описана ---
# Обе стороны приводятся к виду "alt+ctrl+shift+super+key": раскладка
# sxhkd {a,b} раскрывается, группы в шпаргалке («Стрелки», «H / J / K / L»,
# «1..9, 0», «Громкость +/-») разворачиваются в отдельные клавиши. Порядок
# модификаторов и форматирование строк не важны.

canon_key() {
    local k=${1,,}
    k=${k#\\}
    case "$k" in
        return|escape|tab|space|minus) echo "$k" ;;
        slash|/)          echo '/' ;;
        grave)            echo '`' ;;
        left|right|up|down) echo "$k" ;;
        bracketleft)      echo '[' ;;
        bracketright)     echo ']' ;;
        comma)            echo ',' ;;
        period)           echo '.' ;;
        *)                echo "$k" ;;
    esac
}

canon_combo() {
    local IFS=+
    local -a parts m=()
    local p key=""
    read -ra parts <<< "$1"
    for p in "${parts[@]}"; do
        p=${p//[[:space:]]/}
        case "$p" in
            ""|_)              ;;
            super|Super|Mod4)  m+=(super) ;;
            alt|Alt|Mod1)      m+=(alt) ;;
            shift|Shift)       m+=(shift) ;;
            ctrl|Ctrl|Control) m+=(ctrl) ;;
            fn|Fn)             m+=(fn) ;;
            *)                 key=$p ;;
        esac
    done
    [ -n "$key" ] || return
    # Функциональные клавиши в шпаргалке записаны как Fn + ...
    case "$key" in
        XF86AudioRaiseVolume)  m+=(fn); key=volume-up ;;
        XF86AudioLowerVolume)  m+=(fn); key=volume-down ;;
        XF86AudioMute)         m+=(fn); key=mute ;;
        XF86MonBrightnessUp)   m+=(fn); key=brightness-up ;;
        XF86MonBrightnessDown) m+=(fn); key=brightness-down ;;
    esac
    key=$(canon_key "$key")
    local mods=""
    if [ "${#m[@]}" -gt 0 ]; then
        mods=$(printf '%s\n' "${m[@]}" | sort -u | tr '\n' '+')
        mods=${mods%+}
    fi
    if [ -n "$mods" ]; then printf '%s+%s\n' "$mods" "$key"; else printf '%s\n' "$key"; fi
}

expand_braces() {
    local s=$1
    if [[ $s != *"{"* ]]; then
        printf '%s\n' "$s"
        return
    fi
    local pre=${s%%\{*} rest=${s#*\{}
    local body=${rest%%\}*} post=${rest#*\}}
    local IFS=, alt
    for alt in $body; do
        [ "$alt" = "_" ] && alt=""
        if [[ $alt =~ ^([0-9])-([0-9])$ ]]; then
            local i
            for ((i=${BASH_REMATCH[1]}; i<=${BASH_REMATCH[2]}; i++)); do
                expand_braces "$pre$i$post"
            done
        else
            expand_braces "$pre$alt$post"
        fi
    done
}

sheet_add() { # $1 — имя массива, $2 — модификаторы, $3 — клавиша
    local -n out=$1
    local mods=$2 key
    key=$(canon_key "$3")
    [ -n "$key" ] || return
    mods=$(printf '%s' "$mods" | tr ' ' '\n' | sed '/^$/d' | sort -u | tr '\n' '+')
    mods=${mods%+}
    if [ -n "$mods" ]; then out["$mods+$key"]=1; else out["$key"]=1; fi
}

parse_sheet() { # $1 — файл шпаргалки, $2 — имя массива
    local file=$1 line keypart first rest head spec k r i
    local -a parts
    while IFS= read -r line; do
        [[ $line == \#* ]] && continue
        line=${line%%<span*}
        keypart=${line%%  *}
        keypart=${keypart#* }
        keypart=${keypart# }
        keypart=${keypart% }
        [ -n "$keypart" ] || continue
        first=${keypart%% *}
        case "${first,,}" in
            super|ctrl|alt|shift|fn|print) ;;
            *) continue ;;
        esac
        rest=$keypart
        local mods=""
        while [[ $rest == *" + "* ]]; do
            head=${rest%% + *}
            case "${head,,}" in
                super|ctrl|alt|shift|fn)
                    mods+="${head,,} "
                    rest=${rest#* + }
                    ;;
                *) break ;;
            esac
        done
        spec=$rest
        case "$spec" in
            "Громкость +/-")
                sheet_add "$2" "$mods" volume-up
                sheet_add "$2" "$mods" volume-down
                ;;
            "Яркость +/-")
                sheet_add "$2" "$mods" brightness-up
                sheet_add "$2" "$mods" brightness-down
                ;;
            "Стрелки")
                for k in left right up down; do sheet_add "$2" "$mods" "$k"; done
                ;;
            "Mute")
                sheet_add "$2" "$mods" mute
                ;;
            "/")
                sheet_add "$2" "$mods" "/"
                ;;
            *".."*)
                IFS=' ' read -ra parts <<< "${spec//,/ }"
                for r in "${parts[@]}"; do
                    if [[ $r =~ ^([0-9])\.\.([0-9])$ ]]; then
                        for ((i=${BASH_REMATCH[1]}; i<=${BASH_REMATCH[2]}; i++)); do
                            sheet_add "$2" "$mods" "$i"
                        done
                    else
                        sheet_add "$2" "$mods" "$r"
                    fi
                done
                ;;
            */*)
                IFS=' ' read -ra parts <<< "${spec//\// }"
                for k in "${parts[@]}"; do
                    sheet_add "$2" "$mods" "$k"
                done
                ;;
            *)
                sheet_add "$2" "$mods" "${spec// /}"
                ;;
        esac
    done < "$file"
}

declare -A sheet_bspwm=() sheet_sway=() seen=()
parse_sheet local/bin/cheatsheet-bspwm sheet_bspwm
parse_sheet local/bin/sway-cheatsheet sheet_sway

# SXHKD: ключевые строки без отступа, команды — с отступом.
while IFS= read -r line; do
    [[ $line == \#* || $line == [[:space:]]* ]] && continue
    [[ -n ${line// /} ]] || continue
    while IFS= read -r combo; do
        combo=$(canon_combo "$combo")
        [ -n "$combo" ] || continue
        [ -n "${seen[$combo]:-}" ] && continue
        seen[$combo]=1
        [ -n "${sheet_bspwm[$combo]:-}" ] || bad "шпаргалка BSPWM: нет $combo"
    done < <(expand_braces "$line")
done < config/sxhkd/sxhkdrc

# SWAY: подставляем $mod/$left… из set, режимные клавиши без модификаторов
# (Left/Return/Escape внутри mode resize) пропускаем.
declare -A sway_vars=()
seen=()
while IFS= read -r line; do
    if [[ $line =~ ^set[[:space:]]+\$([A-Za-z0-9_]+)[[:space:]]+(.+)$ ]]; then
        sway_vars[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}
    fi
done < config/sway/config

while IFS= read -r line; do
    combo=""
    for tok in $line; do
        case "$tok" in
            bindsym) ;;
            -*) ;;
            *) combo=$tok; break ;;
        esac
    done
    [ -n "$combo" ] || continue
    while [[ $combo =~ \$([A-Za-z0-9_]+) ]]; do
        name=${BASH_REMATCH[1]}
        combo=${combo//\$$name/${sway_vars[$name]:-}}
    done
    case "$combo" in
        *+*) ;;
        Print|XF86*) ;;
        *) continue ;;
    esac
    combo=$(canon_combo "$combo")
    [ -n "$combo" ] || continue
    [ -n "${seen[$combo]:-}" ] && continue
    seen[$combo]=1
    [ -n "${sheet_sway[$combo]:-}" ] || bad "шпаргалка Sway: нет $combo"
done < <(grep '^bindsym' config/sway/config)

# --- Синтаксис скриптов и картинки из README ---
# Файл, удалённый из рабочего дерева, но ещё не закоммиченный, пропускаем:
# иначе переименование команды валит проверку до коммита.
while IFS= read -r file; do
    [ -f "$file" ] || continue
    # Не исполняемые файлы — документация (docs/),
    # а не скрипты: bash -n на них заведомо падает.
    [ -x "$file" ] || continue
    bash -n "$file" 2>/dev/null || bad "синтаксис: $file"
done < <(git ls-files -- '*.sh' 'local/bin/*' 'config/sxhkd/scripts/*')

while IFS= read -r img; do
    [ -f "$img" ] || bad "нет картинки: $img"
done < <(grep -hoE 'screenshots/[A-Za-z0-9_+.-]*\.(png|webp|jpe?g)' README*.md | sort -u)

if [ "$fail" -ne 0 ]; then
    exit 1
fi
echo "Всё в порядке."
