#!/bin/bash
# ==========================================================
# rice-check — проверка состояния райса и дотфайлов
# ==========================================================
# Запуск: rice-check
# Симлинки на репозиторий, команды и пути из sxhkdrc, bash -n,
# картинки README. Без сети и sudo. 0 — всё в порядке, 1 — проблемы.
# ==========================================================

set -u

SELF=$(readlink -f "$0")
DOTFILES=$(cd "$(dirname "$SELF")/../.." && pwd)
cd "$DOTFILES" || exit 1

fail=0
bad() { printf 'FAIL  %s\n' "$*"; fail=1; }

# --- Симлинки: репозиторий -> живая система ---
check_link() {
    local live=$1 want=$2 real
    if [ ! -L "$live" ]; then
        bad "$live: нет симлинка (запусти ./scripts/link.sh)"
        return
    fi
    real=$(readlink -f "$live")
    case "$real" in
        "$want")       ;;
        "$DOTFILES"/*) bad "$live: ведёт на $real вместо $want" ;;
        *)             bad "$live: ведёт вне репозитория ($real)" ;;
    esac
}

for dir in config/*/; do
    pkg=$(basename "$dir")
    check_link "$HOME/.config/$pkg" "$DOTFILES/config/$pkg"
done
for file in home/*; do
    name=$(basename "$file")
    check_link "$HOME/.$name" "$DOTFILES/$file"
done
for file in local/bin/*; do
    check_link "$HOME/.local/bin/$(basename "$file")" "$DOTFILES/$file"
done
for file in local/share/mc/skins/*.ini; do
    check_link "$HOME/.local/share/mc/skins/$(basename "$file")" "$DOTFILES/$file"
done

# --- Команды и пути, на которые ссылается sxhkdrc ---
for cmd in $(grep -oP '^\s{4}\K[^\s]+' config/sxhkd/sxhkdrc | grep -vE '^(~|\$|/|\.)' | sort -u); do
    command -v "$cmd" >/dev/null 2>&1 || bad "нет команды: $cmd"
done
for path in $(grep -oP '^\s{4}\K~/\S+' config/sxhkd/sxhkdrc | sort -u); do
    [ -x "${path/#\~/$HOME}" ] || bad "нет файла: $path"
done

# --- Синтаксис скриптов и картинки из README ---
while IFS= read -r file; do
    bash -n "$file" 2>/dev/null || bad "синтаксис: $file"
done < <(git ls-files -- '*.sh' 'local/bin/*' 'config/sxhkd/scripts/*')

while IFS= read -r img; do
    [ -f "$img" ] || bad "нет картинки: $img"
done < <(grep -ho 'screenshots/[A-Za-z0-9_+.-]*\.png' README*.md | sort -u)

if [ "$fail" -ne 0 ]; then
    exit 1
fi
echo "Всё в порядке."
