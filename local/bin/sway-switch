#!/bin/bash
# ==========================================================
# sway-switch — переключение окон через wofi
# ==========================================================
# Аналог rofi -show window из BSPWM. `wofi --show window` здесь
# не работает: Sway не реализует wlr-foreign-toplevel-management,
# поэтому список окон берём из дерева Sway, а фокус ставим по con_id.
#
# Вызов: Alt + Tab в Sway (bindsym Alt+Tab exec sway-switch)
# ==========================================================

set -u

if [ -z "${SWAYSOCK:-}" ]; then
    echo "sway-switch: запускать внутри сессии Sway (нет SWAYSOCK)" >&2
    exit 1
fi

# id + класс + заголовок. Контейнеры без pid — не окна, их пропускаем.
list=$(swaymsg -t get_tree -r | jq -r '
    .. | objects
    | select(.pid? != null)
    | "\(.id)  \(.app_id // .window_properties.class // "?") — \(.name // "?")"
')

[ -n "$list" ] || exit 0

choice=$(printf '%s\n' "$list" | wofi --dmenu --cache-file /dev/null \
    --prompt "󰖯 Окна" --width 800 --height 480)

# Esc — ничего не выбрано.
[ -n "$choice" ] || exit 0

id=${choice%%  *}
[ -n "$id" ] || exit 0

swaymsg "[con_id=$id] focus"
