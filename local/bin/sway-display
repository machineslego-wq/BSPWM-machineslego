#!/bin/bash
# ==========================================================
# sway-display — Мониторы и обои для Sway
# ==========================================================
# В bspwm раскладка живёт в bspwmrc через if/else по hostname,
# потому что xrandr выполняется один раз при старте. В конфиге
# Sway условий нет, поэтому геометрия и обои вынесены в отдельную
# команду: она же умеет переприменяться после reload. Привязку
# столов (1–7 → DP-2, 8–10 → HDMI-A-4) готовит sway-session до запуска
# Sway в ~/.cache/sway/workspaces.conf: отсюда она опаздывает к первым
# столам.
#
# Вызывается из config/sway/config: exec_always sway-display
# Вручную: sway-display (внутри сессии Sway)
#
# Примечание по именам выходов: в X11 (xrandr) это были
# DisplayPort-1 / HDMI-A-3, а в Sway (wlroots, DRM) те же
# физические порты называются DP-2 / HDMI-A-4.
# ==========================================================

set -u

WALL="$HOME/BSPWM-machineslego/wallpapers"
LAND="$WALL/tokyo-night-girl-landscape.jpg"
PORT="$WALL/tokyo-night-girl-portrait.jpg"

if ! command -v swaymsg >/dev/null 2>&1; then
    echo "sway-display: swaymsg не найден (Sway не установлен?)" >&2
    exit 1
fi

if [ -z "${SWAYSOCK:-}" ]; then
    echo "sway-display: запускать внутри сессии Sway (нет SWAYSOCK)" >&2
    exit 1
fi

# При старте сессии Sway выполняет exec до готовности IPC.
# Ждём, пока swaymsg начнёт отвечать и вернёт непустой список выходов
# (в начале старта возможен валидный ответ "[]").
outputs=""
for _ in $(seq 1 20); do
    outputs=$(swaymsg -t get_outputs -r 2>/dev/null) || true
    if [ -n "$outputs" ] && [ "$outputs" != "[]" ]; then
        break
    fi
    sleep 0.25
done

if [ -z "$outputs" ] || [ "$outputs" = "[]" ]; then
    echo "sway-display: swaymsg не отвечает или нет выходов" >&2
    exit 1
fi

has_output() {
    grep -q "\"$1\"" <<<"$outputs"
}

run() {
    swaymsg "$1" >/dev/null 2>&1 || echo "sway-display: не применилось: $1" >&2
}

# Все подключённые выходы включены.
run "output * enable"

# Привязку столов к выходам (1–7 → DP-2, 8–10 → HDMI-A-4) готовит
# sway-session в ~/.cache/sway/workspaces.conf, её подключает
# config/sway/config: `workspace <n> output <выход>` действует только на
# новые столы, а при старте стол 1 создаётся раньше, чем запустится этот
# скрипт. Новый выход, подключённый позже, приоритет из карты учитывает
# сам. Здесь остаются только геометрия, поворот и обои.

if [ "$(hostname)" = "lamer-deb" ] && has_output DP-2 && has_output HDMI-A-4; then
    # ПК: DP-2 — основной 1920x1080@144, HDMI-A-4 — слева, повёрнут на 90°.
    # Геометрия как в bspwmrc: HDMI занимает 1080 px по X и всю высоту 1920;
    # DP стоит правее (1080..3000) и опущен на 250 px от верха, его низ — 1330,
    # ниже остаётся пустая зона 1920x590. Общая область 3000x1920.
    # В Sway координаты position задаются через ПРОБЕЛ: X Y.
    run "output DP-2 mode 1920x1080@144Hz position 1080 250"
    run "output HDMI-A-4 transform 90 position 0 0"

    # Горизонтальные обои на основной, вертикальные — на повёрнутый.
    run "output DP-2 bg $LAND fill"
    run "output HDMI-A-4 bg $PORT fill"
else
    # Ноутбуки и всё остальное: один экран (или зеркало) — горизонтальные
    # обои на каждый выход. Имена выходов не хардкодим.
    run "output * bg $LAND fill"
fi
