#!/bin/bash
# ==========================================================
# rice-help — команды репозитория и алиасы терминала
# ==========================================================
# Печатает команды из local/bin (описание — третья строка файла)
# и алиасы/функции из home/bashrc (комментарий в конце строки).
# Фильтр: rice-help <слово> — только совпавшие строки.
# ==========================================================

set -u

SELF=$(readlink -f "$0")
BIN=$(cd "$(dirname "$SELF")" && pwd)
BASHRC="$BIN/../../home/bashrc"
FILTER=${1:-}

# Секция: заголовок и строки "имя<TAB>описание" со stdin.
# Ширина колонки считается по самой длинной команде в секции.
show() {
    awk -F'\t' -v header="$1" -v f="$FILTER" '
        BEGIN { print header }
        f != "" && index($0, f) == 0 { next }
        {
            name[++n] = $1
            desc[n] = $2
            if (length($1) > w) w = length($1)
            found = 1
        }
        END {
            if (!found) { print "  (нет совпадений)"; exit }
            for (i = 1; i <= n; i++) printf "  %-*s  %s\n", w, name[i], desc[i]
        }'
}

# --- Команды local/bin ---
{
    for file in "$BIN"/*; do
        [ -x "$file" ] && [ -f "$file" ] || continue
        line=$(sed -n '3p' "$file")
        desc=${line#*— }
        [ "$desc" = "$line" ] && desc=${line#\# }
        printf '%s\t%s\n' "$(basename "$file")" "$desc"
    done
} | show "Команды репозитория (local/bin):"

echo

# --- Алиасы и функции из bashrc ---
awk '
    /^alias [A-Za-z0-9_.-]+=/ {
        name = $0
        sub(/^alias /, "", name)
        sub(/=.*$/, "", name)
    }
    /^[a-z0-9_-]+\(\)/ {
        name = $0
        sub(/\(\).*$/, "", name)
    }
    name == "" { next }
    {
        desc = $0
        if (match(desc, /#[^#]*$/)) {
            desc = substr(desc, RSTART + 1)
            gsub(/^[ \t]+|[ \t]+$/, "", desc)
        } else {
            desc = ""
        }
        printf "%s\t%s\n", name, desc
        name = ""
    }
' "$BASHRC" | show "Терминал без лаунчера (алиасы из ~/.bashrc):"

echo
if [ -n "$FILTER" ]; then
    echo "Фильтр: $FILTER. Без аргумента — полный список."
else
    echo "Поиск: rice-help <слово>. Подробнее: <команда> --help."
fi
