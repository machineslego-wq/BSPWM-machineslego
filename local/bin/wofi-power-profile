#!/bin/bash
# ==========================================================
# wofi-power-profile — Профили питания для Sway (wofi)
# ==========================================================
# Аналог power-profile для BSPWM: меню рисует wofi, Picom
# не перезапускается (под Sway его нет). Уведомления идут
# через notify-send → mako.
#
# Вызов: wofi-power-profile --menu   (Super + Alt + P)
#        wofi-power-profile          только статус (для панели)
# ==========================================================

set -u

# --- Получение текущего статуса ---
get_status() {
    PROFILE=$(powerprofilesctl get 2>/dev/null)
    case "$PROFILE" in
        performance) echo "󰓅 PERF" ;;
        balanced)    echo "󰒓 BAL"  ;;
        power-saver) echo "󰾆 ECO"  ;;
        *)           echo "󰒓 $PROFILE" ;;
    esac
}

# --- Режим меню (вызов: --menu) ---
if [ "${1:-}" = "--menu" ]; then
    CHOICE=$(printf '󰓅 Performance\n󰒓 Balanced\n󰾆 Power Saver' | \
        wofi --dmenu --cache-file /dev/null --insensitive \
            --prompt "Профиль питания" --width 420 --lines 5)

    # Esc — ничего не выбрано
    [ -z "$CHOICE" ] && exit 0

    case "$CHOICE" in
        *"Performance"*)
            if powerprofilesctl set performance 2>/dev/null; then
                notify-send -u low -a "Power" "Режим Performance" \
                    "Максимальная производительность."
            else
                notify-send -u critical -a "Power" "Ошибка" \
                    "Профиль performance недоступен на этом железе"
            fi
            ;;
        *"Balanced"*)
            if powerprofilesctl set balanced 2>/dev/null; then
                notify-send -u low -a "Power" "Режим Balanced" \
                    "Сбалансированный режим."
            else
                notify-send -u critical -a "Power" "Ошибка" \
                    "Профиль balanced недоступен"
            fi
            ;;
        *"Power Saver"*)
            if powerprofilesctl set power-saver 2>/dev/null; then
                notify-send -u low -a "Power" "Режим Eco" \
                    "Энергосбережение."
            else
                notify-send -u critical -a "Power" "Ошибка" \
                    "Профиль power-saver недоступен"
            fi
            ;;
    esac
    exit 0
fi

# --- Обычный режим: только вывод статуса ---
get_status
