#!/bin/bash
# ==========================================================
# cheatsheet-bspwm — Статичная шпаргалка горячих клавиш BSPWM
# ==========================================================
# Скрипт выводит красиво отформатированный список клавиш в Rofi.
# -scroll-method 1 = плавная прокрутка (по одной строке)
# -scroll-method 0 = постраничная прокрутка (PageDown перескакивает на 20 строк)
# Особенности:
# - Иконки Nerd Font для каждого раздела.
# - Теги в конце строк написаны приглушённым цветом (fg-dim):
#   видны как подсказка и участвуют в поиске Rofi. Ширина окна
#   рассчитана по самой длинной строке, чтобы теги не обрезались.
# ==========================================================

cat <<EOF | rofi -dmenu -i -markup-rows -scroll-method 1 -p "󰌌 Горячие клавиши" -theme-str 'window {width: 62em; height: 36em;} listview {lines: 20; scrollbar: true;}'
<b>󰒓 СИСТЕМА И ЗАПУСК</b>
󰌌 Super + /                        Шпаргалка                      <span foreground="#565f89">[помощь, хелп, help, клавиши]</span>
󰆍 Super + Return                   Терминал (Alacritty)           <span foreground="#565f89">[консоль, cmd, shell, terminal]</span>
󰀻 Super + D                        Лаунчер (Rofi)                 <span foreground="#565f89">[меню, пуск, запуск, search]</span>
󰈹 Super + B                        Браузер (Firefox)              <span foreground="#565f89">[браузер, интернет, web, firefox]</span>
󰨞 Super + V                        Редактор (VS Code)             <span foreground="#565f89">[код, редактор, vscode, ide]</span>
󰉋 Super + E                        Файлы (Thunar)                 <span foreground="#565f89">[файлы, проводник, папки, explorer]</span>
󰕾 Super + A                        Микшер звука                   <span foreground="#565f89">[звук, громкость, audio, наушники]</span>
󰖩 Super + Alt + N                  Управление Wi-Fi               <span foreground="#565f89">[сеть, wifi, интернет, хотспот, nmcli]</span>
 Super + Alt + T                  Telegram (flatpak) + Proxy     <span foreground="#565f89">[телеграм, чат, messenger, прокси, proxy]</span>
󰔏 Super + X                        Датчики (терминал)             <span foreground="#565f89">[датчики, сенсоры, нагрев, sensors, watch]</span>
󰑓 Super + Escape                   Перезагрузить SXHKD            <span foreground="#565f89">[рестарт, конфиг, reload]</span>
󰜉 Super + Alt + Shift + R          Перезапуск всего (Reload)      <span foreground="#565f89">[рестарт, окна, wm, polybar, dunst]</span>
󰅌 Super + Ctrl + V                 История буфера (CopyQ)         <span foreground="#565f89">[буфер, clipboard, вставка, copy, paste, история]</span>
󰂚 Super + Alt + H                  История уведомлений            <span foreground="#565f89">[уведомления, уведомление, история, dunst, notify, history]</span>

<b>󰐥 ПИТАНИЕ И БЛОКИРОВКА</b>
 Super + Alt + B                  Батарея (детали)               <span foreground="#565f89">[батарея, battery, заряд, аккумулятор]</span>
󰤆 Super + Shift + Q                Меню питания (Rofi)            <span foreground="#565f89">[poweroff, reboot, logout, lock, питание]</span>
󰓅 Super + Alt + P                  Выбор режима питания           <span foreground="#565f89">[питание, ppd, энергосбережение, батарея]</span>
󰌾 Super + Alt + L                  Заблокировать экран            <span foreground="#565f89">[lock, блокировка, пароль]</span>
󰜉 Super + Alt + Q                  Выход из BSPWM                 <span foreground="#565f89">[выход, quit, exit, logout]</span>
󰜉 Super + Alt + R                  Перезапуск BSPWM               <span foreground="#565f89">[рестарт, wm, reload, bspwm]</span>

<b>󰄄 СКРИНШОТЫ (В БУФЕР)</b>
󰹑 Super + F1                       Весь экран                     <span foreground="#565f89">[скриншот, screenshot, снять, экран, capture]</span>
󰖲 Super + F2                       Активное окно                  <span foreground="#565f89">[скриншот, screenshot, окно, window]</span>
󰩭 Super + Shift + S                Выделенная область             <span foreground="#565f89">[скриншот, screenshot, регион, зона]</span>
󰔛 Super + F3                       Экран (задержка 3с)            <span foreground="#565f89">[скриншот, screenshot, таймер, delay]</span>
󰍹 Super + F4                       Активный монитор               <span foreground="#565f89">[скриншот, screenshot, монитор, экран, monitor]</span>

<b>󰃠 ЯРКОСТЬ И ЗВУК</b>
󰃠 Fn + Яркость +/-                 Яркость +5% / -5%              <span foreground="#565f89">[яркость, brightness, экран]</span>
󰕾 Fn + Громкость +/-               Громкость +5% / -5%            <span foreground="#565f89">[звук, громкость, volume]</span>
󰕾 Fn + Mute                        Выключить/включить звук        <span foreground="#565f89">[mute, звук, тишина]</span>

<b>󰖯 УПРАВЛЕНИЕ ОКНАМИ</b>
󰁔 Super + Стрелки                  Смена фокуса                   <span foreground="#565f89">[окно, window, фокус, focus]</span>
󰩨 Super + Shift + Стрелки          Свап с соседом (тайлы)         <span foreground="#565f89">[окно, window, свап, swap, tiled]</span>
󰩨 Super + H / J / K / L            Двигать флоат (Vim)            <span foreground="#565f89">[окно, window, move, floating, vim]</span>
󰩨 Super + Alt + Стрелки            Изменить размер (растянуть)    <span foreground="#565f89">[окно, window, ресайз, resize]</span>
󰩨 Super + Alt + Shift + Стрелки    Сжать размер                   <span foreground="#565f89">[окно, window, ресайз, resize]</span>
󰍹 Super + 1..9, 0                  Переключить стол               <span foreground="#565f89">[стол, workspace, десктоп]</span>
󰧨 Super + Shift + 1..9, 0          Перенести окно на стол         <span foreground="#565f89">[окно, window, стол, workspace]</span>
󰁔 Super + [                        Предыдущий стол                <span foreground="#565f89">[стол, workspace, prev]</span>
󰁔 Super + ]                        Следующий стол                 <span foreground="#565f89">[стол, workspace, next]</span>
󰒆 Super + \`                       Предыдущее окно                <span foreground="#565f89">[окно, window, prev, cycle]</span>
󰓾 Super + Tab                      Предыдущий стол                <span foreground="#565f89">[стол, workspace, prev, desktop]</span>
󰖯 Alt + Tab                        Поиск по открытым окнам        <span foreground="#565f89">[окно, window, поиск, switch, rofi, alt-tab]</span>
󰒆 Super + C                        Следующее окно                 <span foreground="#565f89">[окно, window, next, cycle]</span>
󰒆 Super + Shift + C                Предыдущее окно                <span foreground="#565f89">[окно, window, prev, cycle]</span>
󰒆 Super + O / I                    История фокуса (назад/вперёд)  <span foreground="#565f89">[окно, window, focus, history]</span>
󰒆 Super + P / B / , / .            Переход по дереву              <span foreground="#565f89">[дерево, tree, parent, brother]</span>
󰅖 Super + W                        Закрыть окно                   <span foreground="#565f89">[окно, window, close, quit, выход]</span>
󰅚 Super + Shift + W                Убить процесс                  <span foreground="#565f89">[окно, window, kill, force, зависло]</span>
󰕰 Super + M                        Режим Monocle (стопка)         <span foreground="#565f89">[окно, window, layout, стопка]</span>

<b>󰕰 РЕЖИМЫ И ПРЕСЕЛЕКТ</b>
󰕰 Super + T                        Тайловый режим                 <span foreground="#565f89">[окно, window, тайлинг, tile, layout]</span>
󰕰 Super + Shift + T                Псевдо-тайловый                <span foreground="#565f89">[окно, window, тайлинг, pseudo]</span>
󰖲 Super + S                        Плавающий режим                <span foreground="#565f89">[окно, window, floating, плавающее]</span>
󰊓 Super + F                        На весь экран                  <span foreground="#565f89">[окно, window, full, развернуть]</span>
󰕰 Super + G                        Свап с самым большим окном     <span foreground="#565f89">[окно, window, biggest, swap]</span>
󰕰 Super + Y                        Отправить помеченное в preselect<span foreground="#565f89">[окно, window, marked, preselect]</span>
󰆉 Super + Ctrl + Стрелки           Preselect (направление)        <span foreground="#565f89">[окно, window, направление, preselect]</span>
󰆉 Super + Ctrl + 1..9              Preselect (пропорция)          <span foreground="#565f89">[окно, window, пропорция, preselect, ratio]</span>
󰅖 Super + Ctrl + Space             Отменить Preselect (окно)      <span foreground="#565f89">[окно, window, отмена, cancel]</span>
󰅖 Super + Ctrl + Shift + Space     Отменить Preselect (стол)      <span foreground="#565f89">[окно, window, отмена, cancel, стол]</span>

<b>󰒆 ФЛАГИ ОКОН (повторное нажатие снимает флаг)</b>
󰒆 Super + Ctrl + M                 Пометить окно (для Super+Y)    <span foreground="#565f89">[окно, window, marked, пометка, preselect]</span>
󰒆 Super + Ctrl + X                 Защитить от закрытия           <span foreground="#565f89">[окно, window, locked, защита, от случайного закрытия]</span>
󰒆 Super + Ctrl + Y                 Показывать на всех столах      <span foreground="#565f89">[окно, window, sticky, везде, на всех столах]</span>
󰒆 Super + Ctrl + Z                 Спрятать с других столов       <span foreground="#565f89">[окно, window, private, скрыть, только свой стол]</span>
EOF