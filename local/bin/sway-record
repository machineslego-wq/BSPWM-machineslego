#!/bin/bash
# ==========================================================
# sway-record — Запись экрана под Wayland (wf-recorder)
# ==========================================================
# Использование: sway-record {full|region}
#   full     весь экран
#   region   выделенная область (slurp, Esc — отмена)
#
# Повторный вызов любого режима останавливает текущую запись:
# wf-recorder корректно закрывает файл только по SIGINT.
#
# Звук не пишется: быстрый клип тихий, запись со звуком — через OBS.
# Кодек — VAAPI на amdgpu, у остальных (Intel, NVIDIA) libx264.
# Файлы: <системные «Видео»>/Screencasts/YYYY-MM-DD_HH-MM-SS.mp4
#        (ru_RU → ~/Видео/Screencasts, en_US → ~/Videos/Screencasts)
# ==========================================================

set -u

MODE="${1:-}"
case "$MODE" in
    full|region) ;;
    *)
        echo "usage: $0 {full|region}" >&2
        exit 1
        ;;
esac

# --- Повторный вызов: остановить запись ---
if pgrep -x wf-recorder >/dev/null; then
    pkill -INT -x wf-recorder
    notify-send -a "Record" -u low -t 2000 "Запись" "Остановлена"
    exit 0
fi

# --- Каталог ---
# Записи лежат в подпапке Screencasts внутри системного каталога видео: его
# имя зависит от локали (ru_RU → ~/Видео, en_US → ~/Videos), поэтому путь
# спрашиваем у xdg-user-dir, а не хардкодим. Утилиты нет или каталог не
# настроен (вернёт $HOME) — ~/Videos/Screencasts, как раньше.
VIDEOS=$(xdg-user-dir VIDEOS 2>/dev/null)
[ -n "$VIDEOS" ] && [ "$VIDEOS" != "$HOME" ] || VIDEOS="$HOME/Videos"
DIR="$VIDEOS/Screencasts"
mkdir -p "$DIR"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).mp4"

# --- Монитор для записи ---
# Без -o wf-recorder спрашивает номер выхода в терминале. Под хоткеем
# stdin/stdout перенаправлены, ответить некому — на мультимониторе запись
# молча не стартует (на ноутбуке выход один, поэтому там не воспроизводится).
# Для полного экрана берём монитор с фокусом, для области — тот, где она
# начинается; wf-recorder пишет только один монитор за раз.
output_at() {
    swaymsg -t get_outputs -r 2>/dev/null | jq -r --argjson x "$1" --argjson y "$2" '
        .[] | select(.active)
        | select($x >= .rect.x and $x < (.rect.x + .rect.width)
             and $y >= .rect.y and $y < (.rect.y + .rect.height))
        | .name' 2>/dev/null | head -n 1
}

focused_output() {
    swaymsg -t get_outputs -r 2>/dev/null |
        jq -r '.[] | select(.active and .focused) | .name' 2>/dev/null | head -n 1
}

# --- Кодек: VAAPI только на amdgpu, остальные (Intel, NVIDIA) — libx264 ---
# На Intel iGPU аппаратный путь h264_vaapi падает, поэтому он оставлен
# только для проверенной связки amdgpu. Область и так всегда libx264:
# VAAPI у AMD требует минимум 128x128, а slurp может дать меньше.
amdgpu_render_node() {
    local node
    for node in /dev/dri/renderD*; do
        [ -e "$node" ] || continue
        if [ "$(basename "$(readlink -f "/sys/class/drm/$(basename "$node")/device/driver" 2>/dev/null)" 2>/dev/null)" = amdgpu ]; then
            printf '%s' "$node"
            return 0
        fi
    done
    return 1
}

CODEC=(-c libx264)
if [ "$MODE" = full ]; then
    # Номер render-узла не фиксирован: на ПК с i5 + RX 7700 XT renderD128 —
    # это Intel i915, а amdgpu получает renderD129. Поэтому узел ищем
    # по драйверу, а не по номеру.
    if VAAPI_DEV=$(amdgpu_render_node); then
        CODEC=(-c h264_vaapi -d "$VAAPI_DEV" -F scale_vaapi=format=nv12)
    fi
fi

ARGS=(-f "$FILE" "${CODEC[@]}")
LABEL="весь экран"

# --- Область: h264 требует чётных сторон, slurp может дать нечётные ---
if [ "$MODE" = region ]; then
    GEOM=$(slurp 2>/dev/null) || exit 1
    [ -n "$GEOM" ] || exit 1

    X=${GEOM%%,*}
    REST=${GEOM#*,}
    Y=${REST%% *}
    SIZE=${GEOM##* }
    W=${SIZE%x*}
    H=${SIZE#*x}
    W=$((W - W % 2))
    H=$((H - H % 2))
    [ "$W" -ge 2 ] && [ "$H" -ge 2 ] || exit 1

    ARGS+=(-g "$X,$Y ${W}x$H")
    LABEL="область"
    OUTPUT=$(output_at "$X" "$Y")
else
    OUTPUT=$(focused_output)
fi
# Выход не определился (нет jq/swaymsg) — оставляем выбор wf-recorder.
[ -n "${OUTPUT:-}" ] && ARGS+=(-o "$OUTPUT")

setsid wf-recorder "${ARGS[@]}" >/dev/null 2>&1 &
notify-send -a "Record" -u low -t 2000 "Запись" "REC ($LABEL) → $FILE"
