#!/bin/bash
# ==========================================================
# sway-cheatsheet — Шпаргалка горячих клавиш Sway
# ==========================================================
# Аналог cheatsheet-bspwm, меню по умолчанию рисует rofi (XWayland).
# wofi остаётся запасным бэкендом, если rofi
# перестанет обновляться или сломается.
# Тот же приём со скрытыми тегами: строка-описание написана цветом
# фона, поэтому не видна, но находится поиском.
#
# Вызов: Super + / в Sway (rofi); вручную: sway-cheatsheet [rofi|wofi]
# Список должен совпадать с config/sway/config.
# ==========================================================

case "${1:-rofi}" in
    wofi)
        menu() {
            wofi --dmenu --allow-markup --cache-file /dev/null \
                --prompt "󰌌 Горячие клавиши" --width 960 --height 650
        }
        ;;
    rofi)
        menu() {
            rofi -dmenu -i -markup-rows -scroll-method 1 \
                -p "󰌌 Горячие клавиши" \
                -theme-str 'window {width: 62em; height: 36em;} listview {lines: 20; scrollbar: true;}'
        }
        ;;
    *)
        echo "usage: $0 {wofi|rofi}" >&2
        exit 1
        ;;
esac

cat <<EOF | menu
<b>󰒓 СИСТЕМА И ЗАПУСК</b>
󰌌 Super + /                        Шпаргалка                      <span foreground="#1a1b26">[помощь, хелп, help, клавиши]</span>
󰆍 Super + Return                   Терминал (alacritty)                <span foreground="#1a1b26">[консоль, cmd, shell, terminal]</span>
󰀻 Super + D                        Лаунчер (rofi)                 <span foreground="#1a1b26">[меню, пуск, запуск, search]</span>
󰈹 Super + B                        Браузер (Firefox)              <span foreground="#1a1b26">[браузер, интернет, web, firefox]</span>
󰨞 Super + V                        Редактор (VS Code)             <span foreground="#1a1b26">[код, редактор, vscode, ide]</span>
󰉋 Super + E                        Файлы (Thunar)                 <span foreground="#1a1b26">[файлы, проводник, папки, explorer]</span>
󰕾 Super + A                        Микшер звука                   <span foreground="#1a1b26">[звук, громкость, audio, наушники]</span>
󰖩 Super + Alt + N                  Wi-Fi (rofi)                   <span foreground="#1a1b26">[сеть, wifi, интернет, хотспот, nmcli]</span>
󰁹 Super + Alt + B                  Батарея: заряд и здоровье      <span foreground="#1a1b26">[батарея, заряд, battery, здоровье, энергия]</span>
 Super + Alt + T                  Telegram (flatpak) + Proxy     <span foreground="#1a1b26">[телеграм, чат, messenger, прокси, proxy]</span>
󰔏 Super + X                        Датчики (alacritty)                 <span foreground="#1a1b26">[датчики, сенсоры, нагрев, sensors, watch]</span>
󰑓 Super + Escape                   Перечитать конфиг Sway         <span foreground="#1a1b26">[рестарт, конфиг, reload, reload]</span>
󰑓 Super + Shift + C                Перечитать конфиг Sway         <span foreground="#1a1b26">[рестарт, конфиг, reload, reload]</span>

<b>󰐥 ПИТАНИЕ И БЛОКИРОВКА</b>
󰌾 Super + Alt + L                  Заблокировать экран            <span foreground="#1a1b26">[lock, блокировка, пароль, swaylock]</span>
󰤆 Super + Shift + Q                Меню питания (rofi)            <span foreground="#1a1b26">[выключить, перезагрузка, выход, powermenu]</span>
󰜉 Super + Shift + E                Выход из Sway                  <span foreground="#1a1b26">[выход, quit, exit, logout, swaynag]</span>
󰒲 Бездействие 10 мин               Автоблокировка (swayidle)      <span foreground="#1a1b26">[idle, таймаут, блокировка, swayidle]</span>

<b>󰄄 СКРИНШОТЫ (В БУФЕР)</b>
󰹑 Super + F1                       Весь экран                     <span foreground="#1a1b26">[скриншот, screenshot, снять, экран, capture]</span>
󰔛 Super + F3                       Экран (задержка 3с)            <span foreground="#1a1b26">[скриншот, screenshot, таймер, delay]</span>
󰍹 Super + F4                       Активный монитор               <span foreground="#1a1b26">[скриншот, screenshot, монитор, экран, monitor]</span>
󰩭 Super + Shift + S                Выделенная область             <span foreground="#1a1b26">[скриншот, screenshot, регион, зона, slurp]</span>
󰏫 Super + Shift + A                Редактор скриншота (swappy)    <span foreground="#1a1b26">[скриншот, screenshot, пометки, annotate]</span>
󰹑 Print                            Весь экран                     <span foreground="#1a1b26">[скриншот, screenshot, print, снять]</span>

<b>󰑊 ЗАПИСЬ ЭКРАНА</b>
󰑊 Super + Shift + R                Запись: весь экран вкл/выкл    <span foreground="#1a1b26">[record, видео, wf-recorder]</span>
󰑊 Super + Shift + Alt + R          Запись: область вкл/выкл       <span foreground="#1a1b26">[запись, область, регион, record, видео]</span>

<b>󰅇 БУФЕР ОБМЕНА</b>
󰅇 Super + Shift + V                История буфера (cliphist)      <span foreground="#1a1b26">[буфер, clipboard, история, вставка, cliphist]</span>

<b>󰃠 ЯРКОСТЬ И ЗВУК</b>
󰃠 Fn + Яркость +/-                 Яркость +5% / -5%              <span foreground="#1a1b26">[яркость, brightness, экран]</span>
󰕾 Fn + Громкость +/-               Громкость +2% / -2%            <span foreground="#1a1b26">[звук, громкость, volume]</span>
󰕾 Fn + Mute                        Выключить/включить звук        <span foreground="#1a1b26">[mute, звук, тишина]</span>

<b>󰖯 УПРАВЛЕНИЕ ОКНАМИ</b>
󰁔 Super + Стрелки                  Смена фокуса                   <span foreground="#1a1b26">[окно, window, фокус, focus]</span>
󰁔 Super + H / J / K / L            Смена фокуса (Vim)             <span foreground="#1a1b26">[окно, window, фокус, focus, vim]</span>
󰓾 Super + C                        Фокус: плавающее ↔ тайл        <span foreground="#1a1b26">[окно, window, focus, floating, tiling, toggle]</span>
󰩨 Super + Shift + Стрелки          Переместить окно               <span foreground="#1a1b26">[окно, window, move, свап, swap]</span>
󰩨 Super + Shift + H / J / K / L    Переместить окно (Vim)         <span foreground="#1a1b26">[окно, window, move, vim]</span>
󰍹 Super + 1..9, 0                  Переключить стол               <span foreground="#1a1b26">[стол, workspace, десктоп]</span>
󰧨 Super + Shift + 1..9, 0          Перенести окно на стол         <span foreground="#1a1b26">[окно, window, стол, workspace]</span>
󰁔 Super + [                        Предыдущий стол                <span foreground="#1a1b26">[стол, workspace, prev]</span>
󰁔 Super + ]                        Следующий стол                 <span foreground="#1a1b26">[стол, workspace, next]</span>
󰓾 Super + Tab                      Предыдущий стол                <span foreground="#1a1b26">[стол, workspace, back, and, forth]</span>
󰅖 Super + W                        Закрыть окно                   <span foreground="#1a1b26">[окно, window, close, quit, выход]</span>
󰊓 Super + F                        На весь экран                  <span foreground="#1a1b26">[окно, window, fullscreen, развернуть]</span>

<b>󰕰 РАСКЛАДКИ И РАЗМЕРЫ</b>
󰕰 Super + T                        Тайл (гориз./верт.)            <span foreground="#1a1b26">[окно, window, тайлинг, tile, split, layout]</span>
󰖲 Super + Shift + T                Вкладки                        <span foreground="#1a1b26">[окно, window, вкладки, tabbed, layout]</span>
󰕰 Super + M                        Стопка (аналог Monocle)        <span foreground="#1a1b26">[окно, window, стопка, stacking, monocle]</span>
󰖲 Super + S                        Плавающее окно                 <span foreground="#1a1b26">[окно, window, floating, плавающее]</span>
󰩨 Super + R                        Режим ресайза                  <span foreground="#1a1b26">[окно, window, ресайз, resize]</span>
󰩨 Стрелки / H J K L в ресайзе      Изменить размер на 10 px       <span foreground="#1a1b26">[окно, window, ресайз, resize, размер]</span>
󰖯 Super + Minus                    Показать скретчпад            <span foreground="#1a1b26">[окно, window, scratchpad, заначка]</span>
󰖯 Super + Shift + Minus            Спрятать в скретчпад           <span foreground="#1a1b26">[окно, window, scratchpad, заначка]</span>
EOF
