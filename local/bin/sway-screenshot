#!/bin/bash
# ==========================================================
# sway-screenshot — скриншоты под Wayland (grim), копия в буфер
# ==========================================================
# Аналог screenshot для BSPWM/X11: maim заменён на grim,
# область — на slurp, буфер — на wl-copy.
#
# Использование: sway-screenshot {full|region|delayed|monitor|annotate}
#   full     весь экран
#   region   выделенная область (slurp, Esc — отмена)
#   delayed  весь экран через 3 секунды
#   monitor  монитор с фокусом
#   annotate открыть в swappy картинку из буфера (после любого скриншота)
#
# CopyQ под Wayland ведёт себя нестабильно, поэтому история
# буфера не пополняется — только системный буфер (Ctrl+V).
# История буфера — отдельно через cliphist (Super + Shift + V).
# ==========================================================

set -u

MODE="${1:-}"
case "$MODE" in
    full|region|delayed|monitor|annotate) ;;
    *)
        echo "usage: $0 {full|region|delayed|monitor|annotate}" >&2
        exit 1
        ;;
esac

# --- Каталог ---
# Скриншоты лежат в подпапке Screenshots внутри системного каталога
# изображений: его имя зависит от локали (ru_RU → ~/Изображения, en_US →
# ~/Pictures), поэтому путь спрашиваем у xdg-user-dir, а не хардкодим.
# Утилиты нет или каталог не настроен (вернёт $HOME) — ~/Screenshots.
PICTURES=$(xdg-user-dir PICTURES 2>/dev/null)
[ -n "$PICTURES" ] && [ "$PICTURES" != "$HOME" ] || PICTURES="$HOME"
DIR="$PICTURES/Screenshots"

# --- Редактор: правит картинку, которая уже лежит в буфере ---
if [ "$MODE" = annotate ]; then
    MIME=$(wl-paste --list-types 2>/dev/null | awk '/^image\// { print; exit }')
    if [ -z "$MIME" ]; then
        notify-send -a "Screenshot" -u low "Скриншот" "В буфере нет изображения"
        exit 1
    fi
    # save_dir в config/swappy/config задан как $XDG_PICTURES_DIR/Screenshots:
    # swappy разворачивает переменные окружения, но сам их не вычисляет,
    # поэтому путь передаём отсюда.
    export XDG_PICTURES_DIR="$PICTURES"
    wl-paste -t "$MIME" | swappy -f -
    exit 0
fi

mkdir -p "$DIR"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"

# --- Захват ---
case "$MODE" in
    full)
        grim "$FILE"
        ;;
    delayed)
        sleep 3
        grim "$FILE"
        ;;
    region)
        # Esc в slurp завершает его с ошибкой — тихо выходим.
        GEOM=$(slurp 2>/dev/null) || exit 1
        [ -n "$GEOM" ] || exit 1
        grim -g "$GEOM" "$FILE"
        ;;
    monitor)
        OUT=$(swaymsg -t get_outputs -r | jq -r '.[] | select(.focused) | .name' | head -n 1)
        [ -n "$OUT" ] || exit 1
        grim -o "$OUT" "$FILE"
        ;;
esac

# --- Отмена/ошибка: файла нет или он пустой ---
if [ ! -s "$FILE" ]; then
    rm -f "$FILE"
    exit 1
fi

# --- Буфер обмена ---
if ! wl-copy < "$FILE"; then
    notify-send -a "Screenshot" -u normal "Скриншот" "Не удалось скопировать в буфер: $FILE"
    exit 1
fi

# --- OSD ---
case "$MODE" in
    full)    LABEL="Весь экран" ;;
    region)  LABEL="Область" ;;
    delayed) LABEL="Экран (3с)" ;;
    monitor) LABEL="Активный монитор" ;;
esac

notify-send -a "Screenshot" -u low -t 2000 \
            "Скриншот" "$LABEL → буфер"
