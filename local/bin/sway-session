#!/bin/bash
# ==========================================================
# sway-session — Запуск Sway с окружением из дотфайлов
# ==========================================================
# Заменяет home/xinitrc и home/xprofile для Wayland: выставляет
# PATH, темы Qt/GTK, курсор, переменные XDG-сессии, готовит карту
# столов по hostname и запускает sway.
# В systemd/dbus окружение прокидывает config/sway/config — от этого
# зависят порталы (ScreenCast, файловые диалоги Flatpak).
#
# Использование:
#   sway-session              из TTY (после логина)
#   Exec=sway-session         в /usr/share/wayland-sessions/*.desktop
#                             (ставится: ./scripts/install-sway.sh --session)
#
# Все аргументы передаются sway: sway-session -c ~/.config/sway/config
# ==========================================================

if [ "$(id -u)" -eq 0 ]; then
    echo "Error: Sway нельзя запускать от root. (Sway must not run as root.)" >&2
    exit 1
fi

if ! command -v sway >/dev/null 2>&1; then
    echo "Error: sway не установлен. Запусти ./scripts/install-sway.sh" >&2
    exit 1
fi

# Из X11 Sway не стартует: нет доступа к DRM, вложенный режим не поддерживается.
if [ "${XDG_SESSION_TYPE:-}" = "x11" ]; then
    echo "Error: ты в X11-сессии. Выйди в TTY (Ctrl+Alt+F3) или выбери сессию Sway в GDM." >&2
    exit 1
fi

# --- PATH: команды из ~/.local/bin (volume, screenshot, sway-session) ---
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$PATH"

# --- Идентификация сессии ---
# Нужна порталам, GTK/GDK и Qt, чтобы приложения выбирали Wayland-путь.
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=sway
export DESKTOP_SESSION=sway

# --- Меню приложений для KDE-софта ---
# Dolphin и другие KF6-приложения строят список «Открыть с помощью» из
# KServiceGroup, а тот ищет $XDG_MENU_PREFIX + applications.menu. В Debian
# файл есть только как plasma-applications.menu (пакет plasma-workspace),
# префикс выставляет сессия Plasma. Без него список пустой — задаём сами.
export XDG_MENU_PREFIX=plasma-

# --- Курсор ---
# Sway берёт тему курсора из этих же переменных (сам и Xwayland-клиенты).
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24

# --- Qt ---
# KDE-приложения (Dolphin, Okular, Ark) красятся только платформенной темой
# kde: палитру, стиль и иконки она берёт из kdeglobals (схема TokyoNight).
# qt6ct задаёт QPalette, но KF6-виджеты его игнорируют — остаются серые
# полосы Breeze. Если Plasma не установлена, остаётся qt6ct с палитрой
# из config/qt6ct.
# wayland;xcb — сначала нативный Wayland, иначе XWayland (старые Qt-приложения).
if ls /usr/lib/*/qt6/plugins/platformthemes/KDEPlasmaPlatformTheme6.so >/dev/null 2>&1; then
    export QT_QPA_PLATFORMTHEME=kde
else
    export QT_QPA_PLATFORMTHEME=qt6ct
fi
export QT_QPA_PLATFORM="wayland;xcb"

# --- GTK ---
# Тема и иконки читаются из config/gtk-3.0 и config/gtk-4.0 (settings.ini + gtk.css),
# GTK_THEME не задаём: он перебил бы пользовательский CSS.
# x11 в списке — для GTK-приложений, у которых нет Wayland-бэкенда.
export GDK_BACKEND="wayland,x11"

# --- LibreOffice ---
# Как в home/xinitrc: рисуем через GTK3, иначе интерфейс будет «сырым».
export SAL_USE_VCLPLUGIN=gtk3

# --- Браузеры, Electron, Java ---
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export _JAVA_AWT_WM_NONREPARENTING=1

# --- systemd ---
# Окружение в systemd/dbus прокидывает сам Sway: config/sway/config,
# строка exec dbus-update-activation-environment --systemd --all.
# Это нужно порталам (ScreenCast/Screenshot) и dbus-сервисам.
#
# Маска создаёт ~/.config/systemd/user/waybar.service -> /dev/null.
# Это блокирует и vendor-версию, и любые попытки enable.
systemctl --user mask waybar.service mako.service lxpolkit.service 2>/dev/null || true

# --- Столы на мониторах ---
# Sway не умеет условий по hostname, а `workspace <n> output <выход>`
# должен попасть в конфиг до создания первых столов (из exec_always это
# поздно). Поэтому карта готовится здесь и подключается из config/sway/config.
# ПК: 1–7 на основной DP-2 (справа), 8–10 на HDMI-A-4 (слева).
# Ноутбук (`lx15pro-deb`) и нетбук (TravelMate): файл пустой — Sway создаёт
# столы на текущем выходе, то есть все десять на одном экране, как ветка
# else в bspwmrc.
workspaces_conf="$HOME/.cache/sway/workspaces.conf"
mkdir -p "${workspaces_conf%/*}"
if [ "$(hostname)" = "lamer-deb" ]; then
    {
        for ws in 1 2 3 4 5 6 7; do
            echo "workspace $ws output DP-2"
        done
        for ws in 8 9 10; do
            echo "workspace $ws output HDMI-A-4"
        done
    } > "$workspaces_conf"
else
    : > "$workspaces_conf"
fi

exec sway "$@"
