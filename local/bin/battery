#!/bin/bash
# ==========================================================
# battery — Детали батареи в rofi (обе сессии; wofi — запасной)
# ==========================================================
# Использование: battery {rofi|wofi}
# Читает upower, показывает заряд, статус, потребление, здоровье
# и оставшееся время. Только просмотр — меню закрывается по Esc.
# ==========================================================

case "${1:-}" in
    rofi)
        # $1 — число строк (ровно по числу пунктов).
        menu() { rofi -dmenu -i -p "󰁹 Батарея" \
                    -theme-str "window {width: 24em;} listview {lines: $1;}"; }
        ;;
    wofi)
        # $1 — число строк; 79 (поле ввода + отступы) + 42 на строку.
        menu() {
            wofi --dmenu --cache-file /dev/null --insensitive \
                --prompt "󰁹 Батарея" --width 428 --height $((79 + 42 * $1))
        }
        ;;
    *)
        echo "usage: $0 {rofi|wofi}" >&2
        exit 1
        ;;
esac

# Сначала системная батарея (battery_BAT*): с беспроводной мышью upower
# отдаёт ещё battery_hidpp_*, и первым в списке может оказаться она.
BAT=$(upower -e 2>/dev/null | grep -m1 '/battery_BAT')
[ -n "$BAT" ] || BAT=$(upower -e 2>/dev/null | grep -m1 '/battery_')
if [ -z "$BAT" ]; then
    echo "Батареи нет" | menu 1
    exit 0
fi

# LC_ALL=C — иначе в ru_RU upower печатает дробные через запятую.
lines=$(LC_ALL=C upower -i "$BAT" 2>/dev/null | awk '
    /state:/ {
        state = $2
        if (state == "charging") state = "Заряжается"
        else if (state == "discharging") state = "Разряжается"
        else if (state == "fully-charged" || state == "full") state = "Заряжена"
        else if (state == "empty") state = "Разряжена"
        else if (state == "pending-charge") state = "Ждёт зарядки"
        else if (state == "pending-discharge") state = "Ждёт разрядки"
    }
    /percentage:/ { pct = $2 }
    /energy-rate:/ { rate = $2 " " $3 }
    /capacity:/ { health = $2 }
    /time to empty:/ { time = "Осталось: " $4 " " $5 }
    /time to full:/ { time = "До полной: " $4 " " $5 }
    END {
        if (pct) print "󱊢 Заряд: " pct
        if (state) print "󱟢 Статус: " state
        if (rate) print "Потребление: " rate
        if (health) print "󱈑 Здоровье: " health
        if (time) print time
    }
')

# upower может не отдать ни одного поля (батарея есть, данных нет):
# без этой строки меню открылось бы пустым.
[ -n "$lines" ] || lines="󰂑 Нет данных от upower"
N=$(printf '%s\n' "$lines" | grep -c .)
printf '%s\n' "$lines" | menu "$N"
