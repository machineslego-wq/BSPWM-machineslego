#!/bin/bash
# ==========================================================
# battery — детали батареи в rofi через upower
# ==========================================================

BAT=$(upower -e 2>/dev/null | grep -m1 '/battery_')
if [ -z "$BAT" ]; then
    echo "Батареи нет" | rofi -dmenu -i -p "󰁹 Батарея" \
        -theme-str 'window {width: 24em;} listview {lines: 6;}'
    exit 0
fi

# LC_ALL=C — иначе в ru_RU upower печатает дробные через запятую.
LC_ALL=C upower -i "$BAT" 2>/dev/null | awk '
    /state:/ {
        state = $2
        if (state == "charging") state = "Заряжается"
        else if (state == "discharging") state = "Разряжается"
        else if (state == "full") state = "Заряжена"
        else if (state == "empty") state = "Разряжена"
    }
    /percentage:/ { pct = $2 }
    /energy-rate:/ { rate = $2 " " $3 }
    /capacity:/ { health = $2 }
    /time to empty:/ { time = "Осталось: " $4 " " $5 }
    /time to full:/ { time = "До полной: " $4 " " $5 }
    END {
        if (pct) print "󱊢 Заряд: " pct
        if (state) print "󱟢 Статус: " state
        if (rate) print "Потребление: " rate
        if (health) print "󱈑 Здоровье: " health
        if (time) print time
    }
' | rofi -dmenu -i -p "󰁹 Батарея" -theme-str 'window {width: 24em;} listview {lines: 6;}'
