#!/bin/bash
# ==========================================================
# powermenu — Меню питания в rofi (BSPWM) или wofi (Sway)
# ==========================================================
# Использование: powermenu {rofi|wofi}
# Один список действий: блокировка, выключение, выход, перезагрузка.
# Блокировка — i3lock-fancy/swaylock, выход — bspc quit/swaymsg exit.
# Перед выходом чистим Qt-переменные из systemd и останавливаем порталы:
# иначе Plasma после Sway наследует qt6ct, а xdg-desktop-portal держит
# конфиг Sway (sway-portals.conf) до перезагрузки.
# ==========================================================

set -u

clean_session() {
    gtk-theme off 2>/dev/null || true

    systemctl --user unset-environment \
        QT_QPA_PLATFORMTHEME QT_STYLE_OVERRIDE QT_QPA_PLATFORM QT_WAYLAND_RECONNECT \
        2>/dev/null || true

    systemctl --user stop \
        xdg-desktop-portal.service \
        xdg-desktop-portal-gtk.service \
        xdg-desktop-portal-wlr.service \
        plasma-xdg-desktop-portal-kde.service \
        2>/dev/null || true
}

case "${1:-}" in
    rofi)
        menu() { rofi -dmenu -p "󰤆 Питание" \
                    -theme-str 'window {width: 17em;} listview {lines: 4;}'; }
        lock() { i3lock-fancy -p; }
        quit_session() { clean_session; bspc quit; }
        ;;
    wofi)
        menu() { wofi --dmenu --cache-file /dev/null --insensitive \
                    --prompt "󰤆 Питание" --width 340 --lines 8; }
        lock() { swaylock -f; }
        quit_session() { clean_session; swaymsg exit; }
        ;;
    *)
        echo "usage: $0 {rofi|wofi}" >&2
        exit 1
        ;;
esac

CHOICE=$(printf '󰌾 Заблокировать\n󰐥 Выключить\n󰍃 Выйти\n󰜉 Перезагрузить' | menu)
[ -z "$CHOICE" ] && exit 0

# Без подтверждения: меню и есть подтверждение.
case "$CHOICE" in
    *"Заблокировать"*) sleep 0.3; lock ;;
    *"Выключить"*)     systemctl poweroff ;;
    *"Выйти"*)         quit_session ;;
    *"Перезагрузить"*) systemctl reboot ;;
esac
