#!/bin/bash
# ==========================================================
# powermenu — Меню питания в rofi (обе сессии; wofi — запасной)
# ==========================================================
# Использование: powermenu {rofi|wofi}
# Один список действий: блокировка, выключение, выход, перезагрузка.
# Бэкенд меню (rofi/wofi) и сессия — разные вещи: блокировка и выход
# выбираются по XDG_CURRENT_DESKTOP, а SWAYSOCK — только если сокет жив.
# Блокировка — i3lock-fancy/swaylock, выход — bspc quit/swaymsg exit.
# Перед выходом чистим переменные сессии в systemd и останавливаем порталы:
# иначе следующая сессия наследует qt6ct, GDK_BACKEND (ломает портал
# GNOME) и мёртвые SWAYSOCK/I3SOCK, а xdg-desktop-portal держит конфиг
# прошлой сессии до перезагрузки.
# ==========================================================

set -u

clean_session() {
    command -v session-cleanup >/dev/null 2>&1 && session-cleanup || true
}

case "${1:-}" in
    rofi)
        menu() { rofi -dmenu -p "󰤆 Питание" \
                    -theme-str 'window {width: 17em;} listview {lines: 4;}'; }
        ;;
    wofi)
        menu() { wofi --dmenu --cache-file /dev/null --insensitive \
                    --prompt "󰤆 Питание" --width 340 --lines 8; }
        ;;
    *)
        echo "usage: $0 {rofi|wofi}" >&2
        exit 1
        ;;
esac

# Действия сессии не зависят от меню: rofi теперь используется и в Sway.
if [[ ${XDG_CURRENT_DESKTOP:-} == *[Ss]way* || -S ${SWAYSOCK:-} ]]; then
    lock() { swaylock -f; }
    quit_session() { clean_session; swaymsg exit; }
else
    lock() { i3lock-fancy -p; }
    quit_session() { clean_session; bspc quit; }
fi

CHOICE=$(printf '󰌾 Заблокировать\n󰐥 Выключить\n󰍃 Выйти\n󰜉 Перезагрузить' | menu)
[ -z "$CHOICE" ] && exit 0

# Без подтверждения: меню и есть подтверждение.
case "$CHOICE" in
    *"Заблокировать"*) sleep 0.3; lock ;;
    *"Выключить"*)     systemctl poweroff ;;
    *"Выйти"*)         quit_session ;;
    *"Перезагрузить"*) systemctl reboot ;;
esac
