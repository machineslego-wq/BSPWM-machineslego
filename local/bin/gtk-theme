#!/bin/bash
# ==========================================================
# gtk-theme — включает/выключает Tokyo Night для GTK3/GTK4
# ==========================================================
# on     — тема Tokyo Night: gtk.css + shell-тема TokyoNight + Adwaita-dark
# off    — снять всё, что мешает GNOME Style: gtk.css -> /dev/null,
#          пустая shell-тема, gtk-theme = Adwaita
# status — показать текущее состояние
# ==========================================================

set -eu

self=$(readlink -f "$0")
root=$(cd "$(dirname "$self")/../.." && pwd)

shell_theme() {
    gsettings set org.gnome.shell.extensions.user-theme name "$1" 2>/dev/null || true
}

gtk_theme() {
    gsettings set org.gnome.desktop.interface gtk-theme "$1" 2>/dev/null || true
}

link_theme() {
    local ver=$1 target=$2
    local dir="$HOME/.config/gtk-$ver"
    mkdir -p "$dir"
    ln -sfn "$target" "$dir/gtk.css"
}

case "${1:-status}" in
    on)
        link_theme 3.0 "$root/config/gtk-3.0/gtk.css"
        link_theme 4.0 "$root/config/gtk-4.0/gtk.css"
        shell_theme TokyoNight
        gtk_theme Adwaita-dark
        echo "Тема Tokyo Night включена: GTK, shell, gtk-theme (нужен перезапуск приложений)."
        ;;
    off)
        link_theme 3.0 /dev/null
        link_theme 4.0 /dev/null
        shell_theme ''
        gtk_theme Adwaita
        echo "Тема снята: GTK, shell и gtk-theme на стоковой Adwaita (Style в GNOME работает)."
        ;;
    status)
        for ver in 3.0 4.0; do
            target=$(readlink -f "$HOME/.config/gtk-$ver/gtk.css" 2>/dev/null || true)
            case "$target" in
                /dev/null|"") echo "gtk-$ver: выключена" ;;
                *) echo "gtk-$ver: включена" ;;
            esac
        done
        printf 'shell: %s\n' "$(gsettings get org.gnome.shell.extensions.user-theme name 2>/dev/null | tr -d "'" || echo '?')"
        printf 'gtk-theme: %s\n' "$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'" || echo '?')"
        ;;
    *)
        echo "usage: $0 {on|off|status}" >&2
        exit 1
        ;;
esac
