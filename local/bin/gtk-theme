#!/bin/bash
# ==========================================================
# gtk-theme — линкует/разлинковывает GTK-конфиги целиком
# ==========================================================
# on     — ~/.config/gtk-3.0 и gtk-4.0 -> каталоги репозитория (Tokyo Night)
# off    — ссылки убираются, gtk-theme=Adwaita: стоковый GNOME
# status — показать состояние
#
# Переключаются только симлинки каталогов: файлы в репозитории не меняются.
# Применение: перезапуск GTK-приложений.
# ==========================================================

set -eu

self=$(readlink -f "$0")
root=$(cd "$(dirname "$self")/../.." && pwd)

usage() { echo "usage: $0 {on|off|status}" >&2; exit 1; }

gtk_theme_name() {
    gsettings set org.gnome.desktop.interface gtk-theme "$1" 2>/dev/null || true
}

link_dirs() {
    local ver dst
    for ver in 3.0 4.0; do
        dst="$HOME/.config/gtk-$ver"
        if [[ -L $dst ]]; then
            ln -sfn "$root/config/gtk-$ver" "$dst"
        elif [[ -e $dst ]]; then
            echo "  gtk-$ver: уже есть настоящий каталог, не трогаю" >&2
        else
            ln -s "$root/config/gtk-$ver" "$dst"
        fi
    done
}

unlink_dirs() {
    local ver dst
    for ver in 3.0 4.0; do
        dst="$HOME/.config/gtk-$ver"
        if [[ -L $dst ]]; then
            rm -f "$dst"
        elif [[ -e $dst ]]; then
            echo "  gtk-$ver: настоящий каталог, не удаляю (убери вручную)" >&2
        fi
    done
}

case "${1:-status}" in
    on)
        link_dirs
        gtk_theme_name Adwaita-dark
        echo "GTK-тема Tokyo Night включена (ссылки на config/gtk-3.0 и gtk-4.0)."
        ;;
    off)
        unlink_dirs
        gtk_theme_name Adwaita
        echo "GTK-тема выключена: GTK на стоковой Adwaita (gtk-theme=Adwaita)."
        ;;
    status)
        for ver in 3.0 4.0; do
            dst="$HOME/.config/gtk-$ver"
            if [[ -L $dst ]]; then
                echo "gtk-$ver: ссылка на $(readlink "$dst")"
            elif [[ -e $dst ]]; then
                echo "gtk-$ver: настоящий каталог"
            else
                echo "gtk-$ver: нет (стоковая Adwaita)"
            fi
        done
        printf 'gtk-theme: %s\n' "$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")"
        ;;
    *) usage ;;
esac
