#!/bin/bash
# ==========================================================
# wofi-wifi — Управление Wi-Fi для Sway (wofi)
# ==========================================================
# Аналог wifi для BSPWM: nmcli тот же, меняется только
# фронтенд — wofi вместо rofi и foot вместо alacritty
# (пароль вводится в терминале через nmcli --ask).
#
# Вызов: Super + Alt + N в Sway.
#
# ИНСТРУКЦИЯ ДЛЯ ПОЛЬЗОВАТЕЛЯ:
# 1. Задайте имя и пароль для хотспота ниже.
# 2. Убедитесь, что имя вашего Wi-Fi адаптера (wlan0, wlo1) верное.
# ==========================================================

set -u

# --- НАСТРОЙКИ ХОТСПОТА ---
HOTSPOT_SSID="BSPWM-Hotspot"
HOTSPOT_PASSWORD="i-use-debian-btw"

# --- ОПРЕДЕЛЕНИЕ ИНТЕРФЕЙСА ---
HOSTNAME=$(hostname)

if [ "$HOSTNAME" = "travelmate" ]; then
    WIFI_IFACE="wlp3s0"
elif [ "$HOSTNAME" = "lx15pro" ] || [ "$HOSTNAME" = "lx15pro-deb" ]; then
    WIFI_IFACE="wlo1"
elif [ "$HOSTNAME" = "lamer-deb" ]; then
    WIFI_IFACE="wlp7s0"
else
    WIFI_IFACE="wlan0"
fi

# --- МЕНЮ (wofi) ---
# $1 — ширина, $2 — строк (пунктов + 2: поле ввода), $3 — заголовок.
# Пункты приходят на stdin; dynamic_lines в config/wofi/config подрезает окно.
menu() {
    wofi --dmenu --cache-file /dev/null --insensitive \
        --width "$1" --lines "$2" --prompt "$3"
}

notify() {
    notify-send -h string:x-canonical-private-synchronous:wifi -a "Wi-Fi" "$@"
}

# --- ГЛАВНОЕ МЕНЮ ---
WIFI_STATE=$(nmcli radio wifi)

if [ "$WIFI_STATE" = "enabled" ]; then
    TOGGLE_TEXT="󰖪 Выключить Wi-Fi"
else
    TOGGLE_TEXT="󰖩 Включить Wi-Fi"
fi

CHOICE=$(printf "$TOGGLE_TEXT\n󰤨 Подключиться к сети\n󰈈 Скрытая сеть\n󰀂 Включить хотспот\n󰅖 Выключить хотспот" | \
    menu 480 7 "󰖩 Wi-Fi")

case "$CHOICE" in
    *"Включить Wi-Fi"*)
        nmcli radio wifi on
        notify "Адаптер включен"
        ;;
    *"Выключить Wi-Fi"*)
        nmcli radio wifi off
        notify "Адаптер выключен"
        ;;
    *"Подключиться к сети"*)
        notify "Подождите..." "Сканирование сетей..."

        if [ "$WIFI_STATE" = "disabled" ]; then
            notify "Wi-Fi выключен" "Сначала включите адаптер"
            exit 1
        fi

        # Собираем список с иконками: [замок] [иконка сигнала] [SSID]
        NETWORKS=$(nmcli -t -f SSID,SIGNAL,SECURITY device wifi list | awk -F: '
            !seen[$1]++ && $1 != "" {
                sig = $2 + 0;
                if (sig >= 75) w_icon = "󰤨";
                else if (sig >= 50) w_icon = "󰤥";
                else if (sig >= 25) w_icon = "󰤢";
                else if (sig > 0) w_icon = "󰤟";
                else w_icon = "󰤯";

                if ($3 == "" || $3 == "--") l_icon = "󰌿";
                else l_icon = "󰌾";

                print l_icon " " w_icon " " $1
            }')

        if [ -z "$NETWORKS" ]; then
            notify "Сети не найдены" "Проверьте адаптер"
            exit 1
        fi

        NET_CHOICE=$(printf '%s\n' "$NETWORKS" | menu 580 14 "Выбор сети")

        if [ -n "$NET_CHOICE" ]; then
            # Отрезаем две иконки и два пробела, оставляя только SSID
            SSID=$(printf '%s' "$NET_CHOICE" | cut -d ' ' -f 3-)

            # Пытаемся подключиться тихо (если пароль уже сохранен)
            if nmcli device wifi connect "$SSID" > /dev/null 2>&1; then
                notify "Подключено" "SSID: $SSID"
            else
                # Пароль вводится в терминале, SSID передаём через окружение
                SSID_ENV="$SSID" foot --app-id wifi -e bash -c \
                    'printf "%s\n" "Подключение к $SSID_ENV..."; nmcli device wifi connect "$SSID_ENV" --ask; printf "\n%s\n" "Нажмите Enter для выхода..."; read' &
            fi
        fi
        ;;
    *"Скрытая сеть"*)
        if [ "$WIFI_STATE" = "disabled" ]; then
            notify "Wi-Fi выключен" "Сначала включите адаптер"
            exit 1
        fi

        # Пустой stdin → wofi показывает только поле ввода
        HIDDEN_SSID=$(printf '' | menu 580 3 "SSID скрытой сети")

        if [ -n "$HIDDEN_SSID" ]; then
            notify "Подождите..." "Подключение к скрытой сети..."

            HIDDEN_SSID_ENV="$HIDDEN_SSID" foot --app-id wifi -e bash -c \
                'printf "%s\n" "Подключение к скрытой сети: $HIDDEN_SSID_ENV"; nmcli device wifi connect "$HIDDEN_SSID_ENV" hidden yes --ask; printf "\n%s\n" "Нажмите Enter для выхода..."; read' &
        fi
        ;;
    *"Включить хотспот"*)
        if nmcli device wifi hotspot ifname "$WIFI_IFACE" ssid "$HOTSPOT_SSID" password "$HOTSPOT_PASSWORD" > /dev/null 2>&1; then
            notify-send -u critical -t 0 \
                        -h string:x-canonical-private-synchronous:hotspot \
                        -a "Hotspot" \
                        "Хотспот включен" "SSID: $HOTSPOT_SSID\nПароль: <b>$HOTSPOT_PASSWORD</b>"
        else
            notify-send -u critical \
                        -h string:x-canonical-private-synchronous:hotspot \
                        -a "Hotspot" \
                        "Ошибка хотспота" "Проверьте поддержку AP-режима"
        fi
        ;;
    *"Выключить хотспот"*)
        nmcli radio wifi off
        sleep 1
        nmcli radio wifi on
        sleep 1
        notify-send -h string:x-canonical-private-synchronous:hotspot \
                    -a "Hotspot" \
                    "Хотспот выключен" "Попытка восстановить подключение..."
        ;;
esac
