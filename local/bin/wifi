#!/bin/bash
# ==========================================================
# wifi — Управление Wi-Fi (rofi в BSPWM, wofi в Sway)
# ==========================================================
# Использование: wifi {rofi|wofi}
# Меню: включить/выключить адаптер, подключиться к сети, скрытая
# сеть, хотспот вкл/выкл. Пароль спрашивается в терминале
# (alacritty / foot), если nmcli его не знает.
# ==========================================================

set -u

HOTSPOT_SSID="BSPWM-Hotspot"
HOTSPOT_PASSWORD="i-use-debian-btw"

case "${1:-}" in
    rofi)
        # $1 — prompt, $2 — число пунктов; список сетей — не длиннее 12 строк.
        menu() {
            local n=$2
            [ "$n" -gt 12 ] && n=12
            rofi -dmenu -p "$1" \
                -theme-str "window {width: 24em;} listview {lines: $n;}"
        }
        term() { alacritty --class wifi -e "$@"; }
        ;;
    wofi)
        # $1 — prompt, $2 — число пунктов, $3/$4 — минимум/максимум строк.
        # +1 строка на поле ввода; минимум 8, чтобы окно не было крошечным.
        menu() {
            local n=$(($2 + 1)) min=${3:-8} max=${4:-16}
            [ "$n" -lt "$min" ] && n=$min
            [ "$n" -gt "$max" ] && n=$max
            wofi --dmenu --cache-file /dev/null --insensitive \
                --width 440 --prompt "$1" --lines "$n"
        }
        term() { foot --app-id wifi -e "$@"; }
        ;;
    *)
        echo "usage: $0 {rofi|wofi}" >&2
        exit 1
        ;;
esac

notify() {
    notify-send -a "Wi-Fi" -h "string:x-canonical-private-synchronous:${SYNC:-wifi}" "$@"
}

# Уровень сигнала (0–100) → иконка Nerd Font.
signal_icon() {
    if   [ "$1" -ge 75 ]; then printf '󰤨'
    elif [ "$1" -ge 50 ]; then printf '󰤥'
    elif [ "$1" -ge 25 ]; then printf '󰤢'
    elif [ "$1" -gt 0 ];  then printf '󰤟'
    else                       printf '󰤯'
    fi
}

# nmcli сам выбирает Wi-Fi-адаптер, имя интерфейса не нужно.
# --escape no оставляет двоеточия в SSID как есть. Строка nmcli —
# "94:Home6": read с IFS=: берёт цифры в sig, а в ssid — весь остаток
# (даже если в имени есть ":"). Повторы SSID отбрасываем: первым идёт
# самый сильный BSSID.
networks() {
    local sig ssid
    declare -A seen=()
    while IFS=: read -r sig ssid; do
        [ -n "$ssid" ] || continue
        [ -n "${seen[$ssid]:-}" ] && continue
        seen[$ssid]=1
        printf '%s | %s\n' "$(signal_icon "${sig:-0}")" "$ssid"
    done < <(nmcli -t --escape no -f SIGNAL,SSID device wifi list)
}

require_on() {
    [ "$STATE" = enabled ] && return 0
    notify "Wi-Fi выключен" "Сначала включите адаптер"
    exit 1
}

# $1 — SSID, $2 — "hidden" для скрытой сети.
ask_password() {
    term bash -c 'printf "%s\n" "Подключение к: $1"
        nmcli device wifi connect "$1" ${2:+hidden yes} --ask
        printf "\nНажмите Enter для выхода...\n"; read' _ "$1" "${2:-}" &
}

STATE=$(nmcli radio wifi)
if [ "$STATE" = enabled ]; then
    TOGGLE="󰖪 Выключить Wi-Fi"
else
    TOGGLE="󰖩 Включить Wi-Fi"
fi

CHOICE=$(printf '%s\n' "$TOGGLE" "󰤨 Подключиться к сети" "󰈈 Скрытая сеть" \
    "󰀂 Включить хотспот" "󰅖 Выключить хотспот" | menu "󰖩 Wi-Fi" 5 8 16)
[ -n "$CHOICE" ] || exit 0

case "$CHOICE" in
    *"Включить Wi-Fi"*)
        nmcli radio wifi on
        notify "Адаптер включён"
        ;;
    *"Выключить Wi-Fi"*)
        nmcli radio wifi off
        notify "Адаптер выключен"
        ;;
    *"Подключиться к сети"*)
        require_on
        notify "Подождите..." "Сканирование сетей..."
        LIST=$(networks)
        [ -n "$LIST" ] || { notify "Сети не найдены" "Проверьте адаптер"; exit 1; }
        N=$(printf '%s\n' "$LIST" | grep -c .)
        SSID=$(printf '%s\n' "$LIST" | menu "Выбор сети" "$N" 8 16)
        [ -n "$SSID" ] || exit 0
        # "󰤨 | Home6" → "Home6": отрезаем всё до "| " включительно.
        # Пробел в шаблоне обязателен, иначе в SSID останется ведущий пробел.
        SSID=${SSID#*| }
        if nmcli device wifi connect "$SSID" >/dev/null 2>&1; then
            notify "Подключено" "SSID: $SSID"
        else
            ask_password "$SSID"
        fi
        ;;
    *"Скрытая сеть"*)
        require_on
        SSID=$(printf '' | menu "SSID скрытой сети" 1 3 5)
        [ -n "$SSID" ] || exit 0
        notify "Подождите..." "Подключение к скрытой сети..."
        ask_password "$SSID" hidden
        ;;
    *"Включить хотспот"*)
        SYNC=hotspot
        if nmcli device wifi hotspot ssid "$HOTSPOT_SSID" \
            password "$HOTSPOT_PASSWORD" >/dev/null 2>&1; then
            notify -u critical -t 0 "Хотспот включён" \
                "SSID: $HOTSPOT_SSID\nПароль: <b>$HOTSPOT_PASSWORD</b>"
        else
            notify -u critical "Ошибка хотспота" "Проверьте поддержку AP-режима"
        fi
        ;;
    *"Выключить хотспот"*)
        SYNC=hotspot
        if nmcli connection down Hotspot >/dev/null 2>&1; then
            notify "Хотспот выключен"
        else
            notify "Хотспот не активен"
        fi
        ;;
esac
