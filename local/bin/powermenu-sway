#!/bin/bash
# ==========================================================
# powermenu-sway — Меню питания для Sway (wofi)
# ==========================================================
# Аналог powermenu для BSPWM: тот же список действий,
# меню рисует wofi (rofi — X11). Блокировка — swaylock
# (стиль и обои берутся из config/swaylock), выход —
# swaymsg exit вместо bspc quit.
#
# Вызов: Super + Shift + Q в Sway.
# ==========================================================

set -u

# --- МЕНЮ ВЫБОРА ---
# Блокировка, Выключить и Выйти сверху, Перезагрузить внизу
CHOICE=$(printf '󰌾 Заблокировать\n󰐥 Выключить\n󰍃 Выйти\n󰜉 Перезагрузить' | \
    wofi --dmenu --cache-file /dev/null --insensitive \
        --prompt "󰤆 Питание" --width 380 --lines 6)

# Esc — меню закрылось пустым, выходим
[ -z "$CHOICE" ] && exit 0

# --- ЛОГИКА (БЕЗ ПОДТВЕРЖДЕНИЯ) ---
case "$CHOICE" in
    *"Заблокировать"*)
        sleep 0.3 && swaylock -f
        ;;
    *"Выключить"*)
        systemctl poweroff
        ;;
    *"Выйти"*)
        swaymsg exit
        ;;
    *"Перезагрузить"*)
        systemctl reboot
        ;;
esac
