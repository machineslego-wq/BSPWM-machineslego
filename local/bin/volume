#!/bin/bash
# ==========================================================
# volume — Управление громкостью с OSD (Dunst / mako)
# ==========================================================

ACTION="$1"

if pgrep -x pipewire >/dev/null; then
    # --- PipeWire ---
    case "$ACTION" in
        up)   wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+ ;;
        down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%- ;;
        mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    esac
    
    # Заставляем awk использовать точку (C-локаль), чтобы 0.50 не превращалось в 0
    VOL=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | LC_ALL=C awk '{print int($2 * 100)}')
    [ -z "$VOL" ] && VOL=0
    
    MUTED=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -o "MUTED")
else
    # --- PulseAudio (фолбэк) ---
    case "$ACTION" in
        up)   pactl set-sink-volume @DEFAULT_SINK@ +2% ;;
        down) pactl set-sink-volume @DEFAULT_SINK@ -2% ;;
        mute) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
    esac
    
    VOL=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}' | head -n 1 | tr -d '%')
    [ -z "$VOL" ] && VOL=0
    MUTED=$(pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}')
fi

# --- Цвет OSD и категория по уровню громкости ---
# Dunst красит рамку и полосу прогресса по хинтам frcolor/hlcolor,
# mako такие хинты не понимает: он выбирает цвета критериями из
# config/mako/config. Поэтому уровень уезжает ещё и в category, а
# mako по ней берёт border-color и progress-color — те же цвета,
# что Dunst получает хинтами.
if [ -n "$MUTED" ]; then
    CATEGORY="volume-mute"
    COLOR="#565f89"
    MSG="Звук выключен"
elif [ "$VOL" -gt 100 ]; then
    CATEGORY="volume-overflow"
    COLOR="#ff0000"
    MSG="Громкость: ${VOL}% (OVERFLOW!)"
elif [ "$VOL" -gt 85 ]; then
    CATEGORY="volume-high"
    COLOR="#f7768e"
    MSG="Громкость: ${VOL}%"
elif [ "$VOL" -gt 55 ]; then
    CATEGORY="volume-mid"
    COLOR="#e0af68"
    MSG="Громкость: ${VOL}%"
else
    CATEGORY="volume-low"
    COLOR="#7aa2f7"
    MSG="Громкость: ${VOL}%"
fi

# --- Отправка уведомления ---
notify-send -h string:x-canonical-private-synchronous:volume \
            -h int:value:"${VOL}" \
            -h string:frcolor:"${COLOR}" \
            -h string:hlcolor:"${COLOR}" \
            -c "${CATEGORY}" \
            -a "Volume" -t 1500 \
            "$MSG"