#!/bin/bash
# ==========================================================
# session-restart — Перезапуск SXHKD, BSPWM и апплетов
# ==========================================================

pkill -USR1 -x sxhkd

# blueman-applet не запускается: Bluetooth — в модуле Polybar.
for app in polybar picom dunst xss-lock lxpolkit copyq; do
    pkill -x "$app" || true
done

bspc wm -r