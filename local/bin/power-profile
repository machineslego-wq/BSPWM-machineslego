#!/bin/bash
# ==========================================================
# power-profile — профиль питания: статус для polybar и меню rofi
# ==========================================================
# Без аргументов — текущий профиль (polybar опрашивает раз в 60 с).
# --menu — выбор профиля: Picom перезапускается с нужным конфигом,
# Polybar — чтобы сразу обновить значок, плюс уведомление.
# ==========================================================

if [ "${1:-}" != "--menu" ]; then
    case "$(powerprofilesctl get 2>/dev/null)" in
        performance) echo "󰓅 PERF" ;;
        balanced)    echo "󰒓 BAL"  ;;
        power-saver) echo "󰾆 ECO"  ;;
        *)           echo "󰒓 ?"    ;;
    esac
    exit 0
fi

CHOICE=$(printf '󰓅 Performance\n󰒓 Balanced\n󰾆 Power Saver (No anim & shadows)' |
    rofi -dmenu -p "Профиль питания" \
        -theme-str 'window {width: 20em;} listview {lines: 3;}')

case "$CHOICE" in
    *Performance*)   profile=performance; conf=picom.conf;     label=Performance; note="анимации включены" ;;
    *Balanced*)      profile=balanced;    conf=picom.conf;     label=Balanced;    note="анимации включены" ;;
    *"Power Saver"*) profile=power-saver; conf=picom-eco.conf; label=Eco;         note="анимации и тени отключены" ;;
    *)               exit 0 ;;
esac

if ! powerprofilesctl set "$profile" 2>/dev/null; then
    notify-send -u critical -a "Power" "Профиль $profile недоступен"
    exit 1
fi

pkill -x picom
sleep 0.2
picom --config "$HOME/.config/picom/$conf" &
notify-send -u low -a "Power" "Режим: $label" "$note"
command -v polybar-msg >/dev/null && polybar-msg cmd restart 2>/dev/null
