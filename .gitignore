# ==========================================================
# Игнорируем ВСЁ по умолчанию
# ==========================================================
/*

# ==========================================================
# Разрешаем только нужные каталоги
# ==========================================================
!/.gitignore
!/polybar/
!/bspwm/
!/sxhkd/
!/rofi/
!/alacritty/
!/picom/
!/dunst/
!readme.md
!screenshot.png
!link.sh
!/fastfetch/

# ==========================================================
# Внутри разрешённых каталогов — тоже чистим мусор
# ==========================================================

# rofi: кэш и история
rofi/*.log
rofi/*.cache
rofi/history

# polybar: бэкапы и логи
polybar/*.bak
polybar/*.log

# alacritty: история и логи
alacritty/*.log
alacritty/history

# Общий мусор внутри всех каталогов
*.bak
*.old
*.swp
*~
*.log
*.tmp
.cache/
__pycache__/
.DS_Store
Thumbs.db