# ==========================================================
# 1. Игнорируем ВСЁ в корне по умолчанию
# ==========================================================
/*

# ==========================================================
# 2. Разрешаем главные папки целиком
# ==========================================================
!/config/
!/home/
!/system/
!/scripts/
!/screenshots/
!/wallpapers/

# ==========================================================
# 3. Разрешаем файлы в корне репозитория
# ==========================================================
!/README.md
!/readme.md
!/LICENSE*
!/.gitignore

# ==========================================================
# 4. Убираем мусор ВНУТРИ разрешённых папок
# ==========================================================
**/*.log
**/*.bak
**/*.old
**/*.swp
**/*.tmp
**/*~
**/.DS_Store
**/Thumbs.db
**/.cache/
**/__pycache__/
**/.vscode/
**/.idea/

# ==========================================================
# 5. Специфичные файлы (истории, которые не нужны в git)
# ==========================================================
config/rofi/history
config/alacritty/history
config/gtk-3.0/bookmarks

# Игнорируем автогенерируемый симлинк профиля питания
config/polybar/scripts/power-profile.sh