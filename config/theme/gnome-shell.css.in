/* ==========================================================
   Tokyo Night — тема GNOME Shell (GNOME 48)
   ==========================================================
   Ставится через расширение User Themes:
     ~/.local/share/themes/TokyoNight/gnome-shell/gnome-shell.css

   Стоковый тёмный CSS подключается целиком, дальше только
   переопределения цветов. Палитра та же, что в GTK/Qt/терминалах:
     фон {{bg}} · панель {{bg_deep}} · поверхность {{surface}}
     поверхность+ {{surface_alt}} · hover {{hover}} · текст {{fg}}
     приглушённый {{muted}} · акцент {{accent}} · красный {{red}}

   !important стоит там, где стоковый CSS считает цвет через
   -st-accent-color (системный акцент): иначе вместо {{accent}}
   остаётся светло-голубой Adwaita.
   ========================================================== */

@import url("resource:///org/gnome/shell/theme/gnome-shell-dark.css");

stage {
    color: {{fg}};
}

/* --- Панель --- */
#panel {
    background-color: {{bg_deep}};
}

#panel .panel-button {
    color: {{fg}};
}

#panel .panel-button:hover,
#panel .panel-button:focus {
    box-shadow: inset 0 0 0 100px rgba(122, 162, 247, 0.16);
}

#panel .panel-button:active,
#panel .panel-button:checked {
    box-shadow: inset 0 0 0 100px rgba(122, 162, 247, 0.28);
}

/* Курсор на открытом меню: стоковый CSS даёт 32% белого */
#panel .panel-button:active:hover,
#panel .panel-button:checked:hover {
    box-shadow: inset 0 0 0 100px rgba(122, 162, 247, 0.34);
}

#panel .panel-button#panelActivities .workspace-dot {
    background-color: {{fg}};
}

#panel .panel-button.screen-recording-indicator {
    box-shadow: inset 0 0 0 100px {{red}};
}

#panel .panel-button.screen-recording-indicator:hover {
    box-shadow: inset 0 0 0 100px {{red_light}};
}

/* --- Меню и подменю --- */
.popup-menu {
    color: {{fg}};
}

.popup-menu-content,
.candidate-popup-content {
    background-color: {{surface}};
    border: 1px solid {{hover}};
    border-radius: 20px;
}

.popup-menu-item {
    color: {{fg}};
}

.popup-menu-item:hover,
.popup-menu-item:selected,
.popup-menu-item:checked {
    color: {{fg}};
    background-color: {{hover}};
}

.popup-menu-item:active {
    color: {{bg}};
    background-color: {{accent}};
}

.popup-menu-item:active:hover {
    background-color: {{accent_hi}};
}

.popup-menu-item:insensitive {
    color: {{muted}};
}

.popup-sub-menu {
    background-color: {{bg}};
}

.popup-separator-menu-item .popup-separator-menu-item-separator {
    background-color: {{hover}};
}

/* --- Кнопки и иконки (быстрые настройки, диалоги) --- */
.button,
.icon-button,
.calendar .calendar-month-header .pager-button,
.message .message-header .message-expand-button,
.message .message-header .message-close-button,
.message-notification-group .message-collapse-button {
    color: {{fg}};
    background-color: {{surface_alt}};
}

.button:hover,
.icon-button:hover,
.calendar .calendar-month-header .pager-button:hover,
.message .message-header .message-expand-button:hover,
.message .message-header .message-close-button:hover,
.message-notification-group .message-collapse-button:hover {
    color: {{fg_bright}};
    background-color: {{hover}};
}

.button:active,
.button:checked,
.icon-button:active,
.icon-button:checked {
    color: {{fg}};
    background-color: {{hover_alt}};
}

/* --- Поля ввода: поиск, переименование --- */
StEntry {
    background-color: {{surface_alt}};
    color: {{fg}};
}

StEntry:hover {
    background-color: {{hover}};
    color: {{fg_bright}};
}

StEntry:focus {
    background-color: {{surface_alt}};
    color: {{fg_bright}};
    box-shadow: inset 0 0 0 2px {{accent}};
}

StEntry:insensitive {
    background-color: {{surface}};
    color: {{muted}};
}

.search-entry {
    background-color: {{surface_alt}};
    color: {{fg}};
}

/* --- Быстрые настройки (шторка справа) --- */
.quick-settings {
    background-color: {{surface}};
}

.quick-toggle {
    background-color: {{surface_alt}};
    color: {{fg}};
}

.quick-toggle:hover {
    background-color: {{hover}};
}

.quick-toggle:checked {
    background-color: {{accent}} !important;
    color: {{bg}} !important;
}

.quick-toggle:checked:hover {
    background-color: {{accent_hi}} !important;
}

.quick-toggle-menu,
.quick-toggle-menu-button {
    background-color: {{surface_alt}};
    color: {{fg}};
}

.quick-toggle-menu:hover,
.quick-toggle-menu-button:hover {
    background-color: {{hover}};
}

.quick-settings-system-item .power-item {
    background-color: {{surface_alt}};
    color: {{fg}};
}

.quick-settings-system-item .power-item:hover {
    background-color: {{hover}};
}

/* --- Переключатели, чекбоксы, ползунки --- */
.toggle-switch {
    background: {{hover}};
}

.toggle-switch .handle {
    background: {{fg}};
}

.toggle-switch:checked {
    background: {{accent}} !important;
    color: {{bg}} !important;
}

.toggle-switch:checked .handle {
    background: {{bg}};
}

.check-box:checked StIcon {
    background-color: {{accent}} !important;
    color: {{bg}} !important;
}

.slider,
.quick-slider .slider {
    color: {{fg}};
    -barlevel-background-color: {{hover}} !important;
    -barlevel-active-background-color: {{accent}} !important;
    -barlevel-overdrive-color: {{red}} !important;
}

/* --- Панель приложений (dash) --- */
#dash .dash-background {
    background-color: {{bg}};
}

.dash-label,
.window-caption,
.screenshot-ui-tooltip {
    background-color: {{surface}};
    border: 1px solid {{hover}};
    color: {{fg}};
}

/* --- Сетка приложений и папки --- */
.app-folder {
    background-color: {{surface_alt}};
    color: {{fg}};
}

.app-folder:hover {
    background-color: {{hover}};
}

.app-folder-dialog {
    background-color: {{surface}};
    color: {{fg}};
}

.app-folder-dialog .folder-name-container .folder-name-entry {
    background-color: {{surface_alt}};
    color: {{fg}};
}

/* --- Уведомления --- */
.notification-banner {
    background-color: {{surface}};
    color: {{fg}};
}

.message {
    background-color: {{surface_alt}};
    color: {{fg}};
}

/* --- Диалоги (выключение, пароль) --- */
.modal-dialog {
    background-color: {{surface}};
    color: {{fg}};
}

.modal-dialog .modal-dialog-button-box .modal-dialog-button {
    background-color: {{surface_alt}};
    color: {{fg}};
}

.modal-dialog .modal-dialog-button-box .modal-dialog-button:hover {
    background-color: {{hover}};
}

/* --- Переключатель окон (Alt+Tab) --- */
.switcher-list {
    background-color: {{surface}};
    color: {{fg}};
}

/* --- OSD громкости и яркости --- */
.osd-window {
    background-color: {{surface}};
    color: {{fg}};
}

.osd-window .level {
    -barlevel-background-color: {{hover}} !important;
    -barlevel-active-background-color: {{accent}} !important;
}

/* --- Календарь и карточки в меню часов --- */
.calendar {
    background-color: transparent;
    color: {{fg}};
}

.calendar .calendar-day,
.calendar .calendar-day-heading,
.calendar .calendar-month-header .calendar-month-label,
.calendar .calendar-month-header .pager-button {
    color: {{fg}};
    background-color: transparent;
}

.calendar .calendar-day-heading,
.calendar .calendar-month-header .calendar-month-label {
    background-color: transparent;
}

.calendar .calendar-day:hover,
.calendar .calendar-day-heading:hover,
.calendar .calendar-month-header .calendar-month-label:hover,
.calendar .calendar-month-header .pager-button:hover {
    background-color: {{hover_alt}};
}

.calendar .calendar-day.calendar-today {
    background-color: {{accent}} !important;
    color: {{bg}} !important;
}

.datemenu-today-button,
.events-button,
.world-clocks-button,
.weather-button {
    background-color: {{surface_alt}};
    color: {{fg}};
}

.datemenu-today-button:hover,
.events-button:hover,
.world-clocks-button:hover,
.weather-button:hover {
    background-color: {{hover}};
}

/* --- Фон обзора и сетки приложений --- */
#overviewGroup {
    background-color: {{surface}};
}

/* --- Составные кнопки быстрых настроек: сегмент со стрелкой --- */
.quick-toggle-has-menu .quick-toggle-menu-button {
    color: {{fg}};
    background-color: {{surface_alt}};
}

.quick-toggle-has-menu .quick-toggle-menu-button:hover {
    color: {{fg_bright}};
    background-color: {{hover}};
}

.quick-toggle-has-menu .quick-toggle-menu-button:checked {
    color: {{bg}};
    background-color: {{accent}} !important;
}

.quick-toggle-has-menu .quick-toggle-menu-button:checked:hover {
    background-color: {{accent_dark_hover}};
}

.quick-toggle-has-menu:checked .quick-toggle-separator {
    background-color: transparent;
}

/* --- Второстепенный текст: календарь и устройства --- */
.events-button .events-box .events-title,
.world-clocks-button .world-clocks-header,
.events-button .events-box .events-list .event-box .event-summary {
    color: {{fg}};
}

.events-button .events-box .events-list .event-placeholder,
.events-button .events-box .events-list .event-box .event-time,
.world-clocks-button .world-clocks-grid .world-clocks-timezone,
.device-subtitle {
    color: {{fg_dim}};
}

/* --- Кружок-иконка в подменю быстрых настроек --- */
.quick-toggle-menu .header .icon {
    background-color: {{hover}};
    color: {{fg}};
}

.quick-toggle-menu .header .icon.active {
    background-color: {{accent}} !important;
    color: {{bg}} !important;
}

/* --- Меню часов: скругления внешнего контейнера --- */
.datemenu-popover {
    background-color: {{surface}};
    border-radius: 30px;
}

/* --- Часы: подсветка висит на дочернем .clock, а не на кнопке --- */
#panel .panel-button.clock-display:focus .clock,
#panel .panel-button.clock-display:hover .clock {
    box-shadow: inset 0 0 0 100px rgba(122, 162, 247, 0.16);
}

#panel .panel-button.clock-display:active .clock,
#panel .panel-button.clock-display:checked .clock {
    box-shadow: inset 0 0 0 100px rgba(122, 162, 247, 0.28);
}

#panel .panel-button.clock-display:active .clock:hover,
#panel .panel-button.clock-display:checked .clock:hover {
    box-shadow: inset 0 0 0 100px rgba(122, 162, 247, 0.34);
}

/* --- Плитки приложений и папок: hover/focus ---
   У стокового CSS состояния :focus:hover специфичнее простого :hover,
   поэтому серый оставался при наведении на сфокусированную плитку. */
.app-folder:hover,
.app-folder:focus,
.app-folder:focus:hover,
.app-folder:active,
.app-folder:active:hover,
.app-folder:checked,
.overview-tile:hover,
.overview-tile:focus,
.overview-tile:focus:hover,
.grid-search-result:hover,
.grid-search-result:focus {
    background-color: {{hover}};
    color: {{fg}};
}

/* --- Док (dash): стоковая серая плитка под каждой иконкой --- */
#dash .dash-item-container .show-apps .overview-icon,
#dash .dash-item-container .overview-tile .overview-icon,
#dash .dash-item-container .grid-search-result .overview-icon {
    color: {{fg}};
    background-color: transparent;
}

#dash .dash-item-container .show-apps:hover .overview-icon,
#dash .dash-item-container .overview-tile:hover .overview-icon,
#dash .dash-item-container .grid-search-result:hover .overview-icon,
#dash .dash-item-container .show-apps:focus .overview-icon,
#dash .dash-item-container .overview-tile:focus .overview-icon,
#dash .dash-item-container .grid-search-result:focus .overview-icon {
    background-color: {{hover}};
}

#dash .dash-item-container .show-apps:checked .overview-icon,
#dash .dash-item-container .overview-tile:checked .overview-icon,
#dash .dash-item-container .grid-search-result:checked .overview-icon,
#dash .dash-item-container .show-apps:active .overview-icon,
#dash .dash-item-container .overview-tile:active .overview-icon,
#dash .dash-item-container .grid-search-result:active .overview-icon {
    background-color: {{hover_alt}};
}

/* Плитка дока не красится целиком — подсветка только у иконки */
#dash .dash-item-container .show-apps,
#dash .dash-item-container .overview-tile,
#dash .dash-item-container .grid-search-result {
    background-color: transparent;
}
