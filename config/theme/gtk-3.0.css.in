/* ==========================================================
   Tokyo Night для GTK3 (поверх Adwaita-dark)
   Меняются только цвета. Геометрия, отступы и размеры
   остаются штатными от Adwaita.
   ========================================================== */

/* Именованные цвета — для приложений, которые используют их
   в собственном CSS. Встроенная Adwaita их не читает, поэтому
   ниже есть прямые селекторы. */
@define-color theme_bg_color {{bg}};
@define-color theme_fg_color {{fg}};
@define-color theme_base_color {{bg}};
@define-color theme_text_color {{fg}};
@define-color theme_selected_bg_color {{accent}};
@define-color theme_selected_fg_color {{bg}};
@define-color insensitive_bg_color {{surface}};
@define-color insensitive_fg_color {{muted}};
@define-color borders {{hover}};

/* Базовый фон и текст */
.background {
    color: {{fg}};
    background-color: {{bg}};
}

.background:backdrop {
    color: {{fg_dim}};
    background-color: {{bg}};
}

/* Области просмотра, иконки, текст */
.view,
iconview,
.view text,
iconview text,
textview text {
    color: {{fg}};
    caret-color: {{accent}};
    background-color: {{bg}};
}

.view:backdrop,
iconview:backdrop,
.view text:backdrop,
iconview text:backdrop,
textview text:backdrop {
    color: {{fg_dim}};
    background-color: {{bg}};
}

.view:disabled,
iconview:disabled,
.view text:disabled,
iconview text:disabled,
textview text:disabled {
    color: {{muted}};
    background-color: {{surface}};
}

.view:selected,
iconview:selected,
.view:selected:focus,
iconview:selected:focus,
.view text:selected,
iconview text:selected,
textview text:selected,
.view text:selected:focus,
iconview text:selected:focus,
textview text:selected:focus {
    color: {{bg}};
    background-color: {{accent}};
}

.view:selected:backdrop,
iconview:selected:backdrop,
.view text:selected:backdrop,
iconview text:selected:backdrop,
textview text:selected:backdrop {
    color: {{fg}};
    background-color: {{border}};
}

/* Выделение текста */
textview text selection,
entry selection,
spinbutton selection,
label selection {
    color: {{bg}};
    background-color: {{accent}};
}

/* Поля ввода */
entry,
spinbutton:not(.vertical) {
    color: {{fg}};
    caret-color: {{accent}};
    background-color: {{bg}};
    background-image: none;
    border-color: {{hover}};
}

entry:focus,
spinbutton:focus:not(.vertical) {
    border-color: {{accent}};
    box-shadow: inset 0 0 0 1px {{accent}};
}

/* Поле поиска wofi: это GtkSearchEntry с именем #input внутри
   #outer-box. Свой CSS wofi ставит с приоритетом APPLICATION (600),
   а этот файл — USER (800), поэтому id-селектор здесь возвращает
   полю фон bg-alt; общее правило entry выше его не перекрывает. */
#outer-box #input {
    background-color: {{surface_alt}};
}

entry:disabled,
spinbutton:disabled:not(.vertical) {
    color: {{muted}};
    background-color: {{surface}};
    border-color: {{surface}};
}

entry:backdrop,
spinbutton:backdrop:not(.vertical) {
    color: {{fg_dim}};
    background-color: {{bg}};
    border-color: {{surface}};
}

entry.error,
spinbutton.error:not(.vertical) {
    color: {{red}};
    border-color: {{red}};
}

entry.warning,
spinbutton.warning:not(.vertical) {
    color: {{yellow}};
    border-color: {{yellow}};
}

entry image {
    color: {{fg_dim}};
}

entry image:hover {
    color: {{fg}};
}

/* Кнопки */
button,
notebook > header > tabs > arrow {
    color: {{fg}};
    background-color: {{surface_alt}};
    background-image: none;
    border-color: {{hover}};
    text-shadow: none;
    -gtk-icon-shadow: none;
    box-shadow: none;
}

button:hover,
notebook > header > tabs > arrow:hover {
    color: {{fg}};
    background-color: {{border_soft}};
    background-image: none;
    border-color: {{border}};
    box-shadow: none;
}

button:active,
button:checked,
notebook > header > tabs > arrow:active,
notebook > header > tabs > arrow:checked {
    color: {{fg}};
    background-color: {{surface}};
    background-image: none;
    border-color: {{border}};
    box-shadow: none;
}

button:disabled,
notebook > header > tabs > arrow:disabled {
    color: {{muted}};
    background-color: {{surface}};
    background-image: none;
    border-color: {{surface}};
    box-shadow: none;
}

button:backdrop,
notebook > header > tabs > arrow:backdrop {
    color: {{fg_dim}};
    background-color: {{surface}};
    background-image: none;
    border-color: {{surface}};
    box-shadow: none;
}

button.flat,
button.titlebutton,
button.sidebar-button {
    background-color: transparent;
    background-image: none;
    border-color: transparent;
    box-shadow: none;
}

button.flat:hover,
button.titlebutton:hover,
button.sidebar-button:hover {
    color: {{fg}};
    background-color: {{surface_alt}};
    background-image: none;
    border-color: {{hover}};
    box-shadow: none;
}

button.suggested-action {
    color: {{bg}};
    background-color: {{accent}};
    background-image: none;
    border-color: {{accent}};
    text-shadow: none;
    box-shadow: none;
}

button.suggested-action:hover {
    color: {{bg}};
    background-color: {{accent_soft}};
    background-image: none;
    border-color: {{accent_soft}};
    box-shadow: none;
}

button.suggested-action:active,
button.suggested-action:checked {
    color: {{bg}};
    background-color: {{accent_mid}};
    background-image: none;
    border-color: {{accent_mid}};
    box-shadow: none;
}

button.destructive-action {
    color: {{bg}};
    background-color: {{red}};
    background-image: none;
    border-color: {{red}};
    text-shadow: none;
    box-shadow: none;
}

button.destructive-action:hover {
    color: {{bg}};
    background-color: {{red_soft}};
    background-image: none;
    border-color: {{red_soft}};
    box-shadow: none;
}

button.destructive-action:active,
button.destructive-action:checked {
    color: {{bg}};
    background-color: {{red_dark}};
    background-image: none;
    border-color: {{red_dark}};
    box-shadow: none;
}

/* Заголовки окон */
headerbar,
.titlebar:not(headerbar) {
    color: {{fg}};
    background-color: {{surface}};
    background-image: none;
    border-color: {{hover}};
    box-shadow: none;
    text-shadow: none;
}

headerbar:backdrop,
.titlebar:backdrop:not(headerbar) {
    color: {{fg_dim}};
    background-color: {{bg}};
    border-color: {{surface}};
}

headerbar.selection-mode,
.selection-mode headerbar,
.selection-mode .titlebar:not(headerbar),
.selection-mode.titlebar:not(headerbar) {
    color: {{bg}};
    background-color: {{accent}};
    background-image: none;
    border-color: {{accent}};
    text-shadow: none;
}

headerbar.selection-mode button,
.selection-mode headerbar button {
    color: {{bg}};
    background-color: rgba(26, 27, 38, 0.1);
    background-image: none;
    border-color: rgba(26, 27, 38, 0.2);
    text-shadow: none;
    box-shadow: none;
}

/* Меню */
menu,
.menu,
.context-menu {
    color: {{fg}};
    background-color: {{surface}};
    border-color: {{hover}};
}

menu:backdrop,
.menu:backdrop,
.context-menu:backdrop {
    color: {{fg_dim}};
    background-color: {{surface}};
    border-color: {{hover}};
}

menu menuitem:hover,
.menu menuitem:hover,
.context-menu menuitem:hover {
    color: {{bg}};
    background-color: {{accent}};
}

menu menuitem:disabled,
.menu menuitem:disabled,
.context-menu menuitem:disabled {
    color: {{muted}};
}

menu menuitem:backdrop,
menu menuitem:backdrop:hover,
.menu menuitem:backdrop,
.menu menuitem:backdrop:hover,
.context-menu menuitem:backdrop,
.context-menu menuitem:backdrop:hover {
    color: {{fg_dim}};
    background-color: transparent;
}

menu > arrow,
.menu > arrow,
.context-menu > arrow {
    background-color: {{surface}};
    border-color: {{hover}};
}

menu > arrow:hover,
.menu > arrow:hover,
.context-menu > arrow:hover {
    background-color: {{border_soft}};
}

menu > arrow.top,
.menu > arrow.top,
.context-menu > arrow.top {
    border-bottom-color: {{hover}};
}

menu > arrow.bottom,
.menu > arrow.bottom,
.context-menu > arrow.bottom {
    border-top-color: {{hover}};
}

/* Строка меню */
menubar,
.menubar {
    color: {{fg}};
    background-color: {{bg}};
    box-shadow: inset 0 -1px {{hover}};
}

menubar:backdrop,
.menubar:backdrop {
    color: {{fg_dim}};
    background-color: {{bg}};
    box-shadow: inset 0 -1px {{surface}};
}

menubar > menuitem:hover,
.menubar > menuitem:hover {
    color: {{accent}};
    box-shadow: inset 0 -3px {{accent}};
}

menubar > menuitem:disabled,
.menubar > menuitem:disabled {
    color: {{muted}};
    box-shadow: none;
}

/* Всплывающие панели */
popover.background,
.csd popover.background {
    color: {{fg}};
    background-color: {{surface}};
    border-color: {{hover}};
}

popover.background:backdrop,
.csd popover.background:backdrop {
    background-color: {{surface}};
}

/* Вкладки */
notebook > header {
    background-color: {{surface}};
    border-color: {{hover}};
}

notebook > header:backdrop {
    background-color: {{bg}};
    border-color: {{surface}};
}

notebook > header tab {
    color: {{fg_dim}};
}

notebook > header tab:hover {
    color: {{fg}};
    background-color: {{surface_alt}};
}

notebook > header tab:checked {
    color: {{fg}};
}

notebook > header tab:backdrop {
    color: {{muted}};
}

notebook > header tab:backdrop:checked {
    color: {{fg_dim}};
}

notebook > header tab:checked.reorderable-page {
    background-color: {{bg}};
    border-color: {{hover}};
}

notebook > header tab:hover.reorderable-page {
    background-color: {{surface_alt}};
    border-color: {{hover}};
}

notebook > header.top > tabs > tab:hover {
    box-shadow: inset 0 -4px {{border}};
}

notebook > header.top > tabs > tab:checked {
    box-shadow: inset 0 -4px {{accent}};
}

notebook > header.bottom > tabs > tab:hover {
    box-shadow: inset 0 4px {{border}};
}

notebook > header.bottom > tabs > tab:checked {
    box-shadow: inset 0 4px {{accent}};
}

notebook > header.left > tabs > tab:hover {
    box-shadow: inset -4px 0 {{border}};
}

notebook > header.left > tabs > tab:checked {
    box-shadow: inset -4px 0 {{accent}};
}

notebook > header.right > tabs > tab:hover {
    box-shadow: inset 4px 0 {{border}};
}

notebook > header.right > tabs > tab:checked {
    box-shadow: inset 4px 0 {{accent}};
}

notebook > stack:not(:only-child) {
    background-color: {{bg}};
}

notebook > stack:not(:only-child):backdrop {
    background-color: {{bg}};
}

/* Полосы прокрутки */
scrollbar {
    background-color: {{bg}};
    border-color: {{hover}};
}

scrollbar:backdrop {
    background-color: {{bg}};
    border-color: {{surface}};
}

scrollbar slider {
    background-color: {{border}};
}

scrollbar slider:hover {
    background-color: {{muted}};
}

scrollbar slider:hover:active {
    background-color: {{accent}};
}

scrollbar slider:backdrop {
    background-color: {{hover}};
}

scrollbar button {
    color: {{muted}};
}

scrollbar button:hover {
    color: {{fg_dim}};
}

scrollbar button:active,
scrollbar button:checked {
    color: {{accent}};
}

scrollbar.overlay-indicator:not(.dragging):not(.hovering) slider {
    background-color: {{muted}};
    border-color: {{bg}};
}

scrollbar.overlay-indicator:not(.dragging):not(.hovering) button {
    background-color: {{muted}};
    border-color: {{bg}};
}

/* Переключатели */
switch {
    color: {{fg}};
    background-color: {{surface_alt}};
    border-color: {{hover}};
    text-shadow: none;
}

switch:checked {
    color: {{bg}};
    background-color: {{accent}};
    border-color: {{accent}};
    text-shadow: none;
}

switch:disabled {
    color: {{muted}};
    background-color: {{surface}};
    border-color: {{surface}};
}

switch:backdrop {
    color: {{fg_dim}};
    background-color: {{surface}};
    border-color: {{surface}};
}

switch:backdrop:checked {
    background-color: {{border}};
    border-color: {{border}};
}

switch slider {
    color: {{bg}};
    background-color: {{fg}};
    background-image: none;
    border-color: {{surface}};
    text-shadow: none;
    box-shadow: none;
}

switch:hover slider {
    background-color: {{white}};
    background-image: none;
    box-shadow: none;
}

switch:checked slider {
    background-color: {{white}};
    background-image: none;
    border-color: {{accent}};
    box-shadow: none;
}

switch:disabled slider {
    background-color: {{muted}};
    background-image: none;
    border-color: {{surface}};
    box-shadow: none;
}

switch:backdrop slider {
    background-color: {{fg_dim}};
    background-image: none;
    border-color: {{surface}};
    box-shadow: none;
}

/* Чекбоксы и радио-кнопки */
check,
radio {
    color: {{fg}};
    background-color: {{surface_alt}};
    background-image: none;
    border-color: {{border}};
    box-shadow: none;
}

check:hover,
radio:hover {
    background-color: {{border_soft}};
    background-image: none;
    box-shadow: none;
}

check:checked,
radio:checked,
check:indeterminate,
radio:indeterminate {
    color: {{bg}};
    background-color: {{accent}};
    background-image: none;
    border-color: {{accent}};
    box-shadow: none;
}

check:checked:hover,
radio:checked:hover,
check:indeterminate:hover,
radio:indeterminate:hover {
    color: {{bg}};
    background-color: {{accent_soft}};
    background-image: none;
    border-color: {{accent_soft}};
    box-shadow: none;
}

check:disabled,
radio:disabled {
    color: {{muted}};
    background-color: {{surface}};
    background-image: none;
    border-color: {{surface}};
    box-shadow: none;
}

check:backdrop,
radio:backdrop {
    background-color: {{surface}};
    background-image: none;
    border-color: {{hover}};
    box-shadow: none;
}

check:checked:backdrop,
radio:checked:backdrop,
check:indeterminate:backdrop,
radio:indeterminate:backdrop {
    color: {{fg}};
    background-color: {{border}};
    background-image: none;
    border-color: {{border}};
    box-shadow: none;
}

/* Прогресс и ползунки */
progressbar trough,
scale fill,
scale trough {
    background-color: {{surface}};
    border-color: {{hover}};
}

progressbar trough:disabled,
scale fill:disabled,
scale trough:disabled {
    background-color: {{bg}};
    border-color: {{surface}};
}

progressbar trough:backdrop,
scale fill:backdrop,
scale trough:backdrop {
    background-color: {{surface}};
    border-color: {{surface}};
}

progressbar progress,
scale highlight {
    background-color: {{accent}};
    border-color: {{accent}};
}

progressbar progress:backdrop,
scale highlight:backdrop {
    background-color: {{border}};
    border-color: {{border}};
}

progressbar {
    color: {{fg_dim}};
}

scale marks,
scale value {
    color: {{fg_dim}};
}

scale slider {
    color: {{bg}};
    background-color: {{fg}};
    background-image: none;
    border-color: {{surface}};
    text-shadow: none;
    box-shadow: none;
}

scale slider:hover {
    background-color: {{white}};
    background-image: none;
    box-shadow: none;
}

scale slider:active {
    background-color: {{accent}};
    background-image: none;
    border-color: {{accent}};
    box-shadow: none;
}

scale slider:disabled {
    background-color: {{muted}};
    background-image: none;
    border-color: {{surface}};
    box-shadow: none;
}

scale slider:backdrop {
    background-color: {{fg_dim}};
    background-image: none;
    border-color: {{surface}};
    box-shadow: none;
}

/* Таблицы и деревья */
treeview.view {
    border-left-color: {{hover}};
    border-top-color: {{bg}};
}

treeview.view:backdrop {
    border-left-color: {{surface}};
    border-top-color: {{bg}};
}

treeview.view:selected,
treeview.view:selected:focus {
    color: {{bg}};
    background-color: {{accent}};
}

treeview.view:selected:backdrop {
    color: {{fg}};
    background-color: {{border}};
}

treeview.view:disabled {
    color: {{muted}};
}

treeview.view:disabled:selected {
    color: {{fg_dim}};
}

treeview.view.separator {
    color: {{hover}};
}

treeview.view.expander {
    color: {{fg_dim}};
}

treeview.view.expander:hover {
    color: {{fg}};
}

treeview.view.expander:selected {
    color: {{bg}};
}

treeview.view.progressbar {
    background-color: {{accent}};
    background-image: image({{accent}});
}

treeview.view.progressbar:selected {
    background-color: {{bg}};
    background-image: image({{bg}});
}

treeview.view.trough {
    background-color: {{surface}};
}

treeview.view.trough:selected {
    background-color: {{border}};
}

treeview.view header button {
    color: {{fg_dim}};
    background-color: {{surface}};
    border-color: {{hover}};
    text-shadow: none;
}

treeview.view header button:hover {
    color: {{fg}};
}

treeview.view header button:active {
    color: {{fg}};
}

treeview.view header button:backdrop {
    color: {{muted}};
    background-color: {{bg}};
    border-color: {{surface}};
}

/* Списки */
list {
    color: {{fg}};
    background-color: {{bg}};
    border-color: {{hover}};
}

list:backdrop {
    color: {{fg_dim}};
    background-color: {{bg}};
    border-color: {{surface}};
}

/* Строки без класса activatable (например, ListBoxRow в простом
   ListBox) тоже должны оставаться читаемыми при выделении */
row:selected {
    color: {{bg}};
    background-color: {{accent}};
}

row:selected:hover {
    color: {{bg}};
    background-color: {{accent_soft}};
}

row:selected:backdrop {
    color: {{fg}};
    background-color: {{border}};
}

row.activatable.has-open-popup,
row.activatable:hover {
    background-color: {{surface_alt}};
}

row.activatable:selected,
row.activatable:selected:hover,
row.activatable:selected.has-open-popup {
    color: {{bg}};
    background-color: {{accent}};
}

row.activatable:selected:backdrop {
    color: {{fg}};
    background-color: {{border}};
}

/* Рамка выделения мышью (rubberband).
   В GTK3 она рисуется контекстом самого виджета с классом .rubberband,
   поэтому без явного правила её заливку перекрывает наш фон .view. */
.rubberband,
rubberband,
treeview.view.rubberband,
iconview.rubberband,
treeview.view rubberband,
iconview rubberband,
flowbox rubberband,
.content-view rubberband,
.content-view .rubberband {
    background-color: rgba(122, 162, 247, 0.2);
    border-color: rgba(122, 162, 247, 0.6);
}

/* Боковые панели */
.sidebar {
    background-color: {{bg_deep}};
    border-color: {{hover}};
}

.sidebar:backdrop {
    background-color: {{bg_deep}};
    border-color: {{surface}};
}

.sidebar list {
    background-color: transparent;
}

separator.sidebar {
    background-color: {{hover}};
}

separator.sidebar:backdrop {
    background-color: {{surface}};
}

.sidebar row:selected {
    color: {{fg}};
    background-color: {{hover}};
}

.sidebar row:selected:hover {
    color: {{fg}};
    background-color: {{border_soft}};
}

placessidebar row:selected {
    color: {{fg}};
}

placessidebar row:disabled {
    color: {{muted}};
}

placessidebar row:backdrop {
    color: {{muted}};
}

placessidebar row:backdrop:selected {
    color: {{fg}};
}

placessidebar row.sidebar-new-bookmark-row {
    color: {{accent}};
}

/* Фреймы, разделители, панели */
frame > border,
.frame {
    border-color: {{hover}};
}

frame > border:backdrop,
.frame:backdrop {
    border-color: {{surface}};
}

separator {
    background-color: {{hover}};
}

paned > separator {
    background-image: image({{hover}});
}

paned > separator:selected {
    background-image: image({{accent}});
}

paned > separator:backdrop {
    background-image: image({{surface}});
}

paned > separator.wide {
    background-color: {{bg}};
    background-image: image({{hover}}), image({{hover}});
}

paned > separator.wide:backdrop {
    background-color: {{bg}};
    background-image: image({{surface}}), image({{surface}});
}

/* Всплывающие подсказки */
tooltip.background {
    color: {{fg}};
    background-color: {{surface}};
    border-color: {{border}};
    text-shadow: none;
}

tooltip * {
    color: {{fg}};
}

/* Индикаторы уровня */
levelbar trough {
    background-color: {{surface}};
    border-color: {{hover}};
}

levelbar block.filled,
levelbar block.high {
    background-color: {{accent}};
    border-color: {{accent}};
}

levelbar block.low {
    background-color: {{yellow}};
    border-color: {{yellow}};
}

levelbar block.full {
    background-color: {{green}};
    border-color: {{green}};
}

/* Календарь */
calendar {
    color: {{fg}};
    background-color: {{bg}};
    border-color: {{hover}};
}

calendar:selected {
    color: {{bg}};
    background-color: {{accent}};
}

calendar.header {
    color: {{fg_dim}};
}

calendar.button {
    color: {{fg_dim}};
}

calendar.highlight {
    color: {{accent}};
}

calendar:indeterminate {
    color: {{muted}};
}

/* Ссылки */
*:link,
button:link,
button:link > label {
    color: {{cyan}};
}

*:visited,
button:visited,
button:visited > label {
    color: {{purple}};
}

*:link:hover,
button:hover:link,
button:link > label:hover {
    color: {{accent_pale}};
}

*:link:disabled,
button:disabled:link,
button:link > label:disabled {
    color: {{muted}};
}

*:link:backdrop,
button:backdrop:link,
button:link > label:backdrop {
    color: {{cyan}};
}

/* Панели инструментов: Adwaita красит их в собственный серый */
toolbar,
.inline-toolbar,
.location-bar,
searchbar > revealer > box {
    color: {{fg}};
    background-color: {{bg}};
    background-image: none;
    border-color: {{hover}};
}

toolbar:backdrop,
.inline-toolbar:backdrop,
.location-bar:backdrop,
searchbar > revealer > box:backdrop {
    color: {{fg_dim}};
    background-color: {{bg}};
    border-color: {{surface}};
}

actionbar > revealer > box {
    background-color: {{bg}};
    border-top-color: {{hover}};
}

actionbar > revealer > box:backdrop {
    background-color: {{bg}};
    border-top-color: {{surface}};
}

/* Ошибки и предупреждения */
/* InfoBar: Adwaita рисует фон на внутреннем revealer > box */
infobar.info > revealer > box,
infobar.question > revealer > box,
infobar.warning > revealer > box,
infobar.error > revealer > box {
    color: {{fg}};
    background-color: {{surface}};
    border-bottom-color: {{hover}};
    text-shadow: none;
}

infobar.info > revealer > box label,
infobar.question > revealer > box label,
infobar.warning > revealer > box label,
infobar.error > revealer > box label {
    color: {{fg}};
}

infobar.warning > revealer > box,
infobar.warning > revealer > box label {
    color: {{yellow}};
}

infobar.error > revealer > box,
infobar.error > revealer > box label {
    color: {{red}};
}

infobar.info button,
infobar.question button,
infobar.warning button,
infobar.error button {
    color: {{fg}};
    background-color: {{surface_alt}};
    background-image: none;
    border-color: {{hover}};
    text-shadow: none;
    box-shadow: none;
}

infobar.info button:hover,
infobar.question button:hover,
infobar.warning button:hover,
infobar.error button:hover {
    color: {{fg}};
    background-color: {{border_soft}};
    background-image: none;
    border-color: {{border}};
    box-shadow: none;
}

/* Popover-меню (гамбургер GNOME Terminal и т.п.): Adwaita красит
   hover в серый (тёмная тема) или белый (светлая) — возвращаем палитру.
   Селекторы без предка popover: GtkPopoverMenu может не иметь класса .menu. */
modelbutton:hover,
modelbutton.flat:hover,
.menuitem.button.flat:hover,
popover modelbutton:hover,
popover.background modelbutton:hover {
    color: {{fg}};
    background-color: {{hover}};
    background-image: none;
}

modelbutton:active,
modelbutton:selected,
modelbutton.flat:selected,
.menuitem.button.flat:selected,
popover modelbutton:active {
    color: {{fg_bright}};
    background-color: {{hover_alt}};
    background-image: none;
}
