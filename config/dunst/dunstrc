# ==========================================================
# Dunst — уведомления в стиле Tokyo Night
# ==========================================================

[global]
    # ------------------------------------------------------
    # --- Расположение и размер ---
    # ------------------------------------------------------
    monitor = 0
    # Уведомления следуют за курсором мыши между мониторами
    follow = mouse
    width = 360
    height = (0, 140)
    origin = top-right
    # Отступ от края экрана (x, y)
    # y=44 — оставляет место под панель Polybar
    offset = (8, 44)
    # Максимум одновременно видимых уведомлений
    notification_limit = 7

    # ------------------------------------------------------
    # --- Полоса прогресса (таймер закрытия) ---
    # ------------------------------------------------------
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 200
    progress_bar_max_width = 340

    # ------------------------------------------------------
    # --- Внешний вид ---
    # ------------------------------------------------------
    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center

    # Через сколько секунд показывать возраст уведомления
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no

    # Группировка одинаковых уведомлений в стопку
    stack_duplicates = true
    hide_duplicate_count = false

    # Иконки
    show_indicators = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_path = /usr/share/icons/Papirus-Dark/24x24/actions/:/usr/share/icons/Papirus-Dark/24x24/panel/:/usr/share/icons/Papirus-Dark/24x24/devices/:/usr/share/icons/Papirus-Dark/24x24/status/

    # ------------------------------------------------------
    # --- История уведомлений ---
    # ------------------------------------------------------
    sticky_history = yes
    history_length = 20

    # ------------------------------------------------------
    # --- Прочее и интеграции ---
    # ------------------------------------------------------
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    # Скругление углов (в пикселях)
    corner_radius = 10

    # Действия мыши на уведомлении
    mouse_left_click   = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click  = close_all

    # ------------------------------------------------------
    # --- Прозрачность и рамка ---
    # ------------------------------------------------------
    # КЛЮЧЕВОЕ: 0 = полностью непрозрачное, 100 = невидимое.
    # 0 выбрано намеренно — в соответствии с философией проекта (без прозрачности).
    transparency = 0

    # Толщина рамки уведомления
    frame_width = 2
    # Отступ между стопкой уведомлений
    gap_size = 8
    # Цвет разделителя берется из цвета рамки текущего уведомления
    separator_color = frame


# ==========================================================
# --- Уровни важности ---
# ==========================================================
# У каждого уровня свой цвет рамки и время показа.

# ----------------------------------------------------------
# Низкая важность (обычные уведомления, скриншоты, подсказки)
# ----------------------------------------------------------
[urgency_low]
    background  = "#1a1b26"
    foreground  = "#c0caf5"
    frame_color = "#7aa2f7"
    # Показывать 5 секунд
    timeout = 5

# ----------------------------------------------------------
# Обычная важность (по умолчанию — если уровень не указан)
# ----------------------------------------------------------
[urgency_normal]
    background  = "#1a1b26"
    foreground  = "#c0caf5"
    frame_color = "#7aa2f7"
    # Показывать 8 секунд
    timeout = 8

# ----------------------------------------------------------
# Критическая важность (ошибки, предупреждения системы)
# ----------------------------------------------------------
[urgency_critical]
    background  = "#1a1b26"
    foreground  = "#f7768e"
    frame_color = "#f7768e"
    # 0 = не закрывать автоматически, только вручную
    timeout = 0