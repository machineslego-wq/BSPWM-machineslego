# ==========================================================
# wofi — лаунчер для Sway (тема Tokyo Night)
# ==========================================================
# Живёт в репозитории: config/wofi -> ~/.config/wofi
# Запуск из Sway: wofi --show drun   (хоткей Super+D)
# Команды: wofi --show run
# Стиль — style.css рядом, читается при каждом запуске.
# ==========================================================

# Режим по умолчанию (drun = .desktop-приложения)
show=drun
prompt=Запуск

# Размер окна по умолчанию. Меню-команды передают свой --width.
width=600
height=400
location=center
orientation=vertical
halign=fill
content_halign=fill

# Поиск
filter_rate=100
matching=fuzzy
key_expand=Tab

# Внешний вид списка. allow_markup глобально выключен: иначе меню
# с текстом, содержащим <...> (clipboard), ругается Pango.
# sway-cheatsheet включает разметку сам флагом --allow-markup.
allow_images=true
image_size=22
allow_markup=false
hide_scroll=true

# Окно подстраивается под число пунктов, но dynamic_lines работает только
# вместе с lines (--lines): меню-скрипты передают его сами. Без lines окно
# висит на height=400.
dynamic_lines=true

# Кнопки действий (Launch/Close) не нужны: выбор по Enter.
no_actions=true

# Слой отрисовки поверх окон.
layer=overlay
