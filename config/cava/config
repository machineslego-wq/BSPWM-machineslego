# ==========================================================
# Cava — консольный аудиовизуализатор (BSPWM-machineslego)
# ==========================================================
# Быстрая реакция на музыку (60 fps) и плавное затухание:
# подъём мгновенный, спад сглажен noise_reduction.
# Цвета — градиент Tokyo Night снизу вверх.

[general]
# 60 кадров в секунду — отклик ~16 мс, визуально «мгновенно»
framerate = 60

# Автоподстройка чувствительности: громкие треки не упираются в потолок
autosens = 1

# Начальная чувствительность, %
sensitivity = 100

# 0 — ширина по числу колонок терминала
bars = 0
bar_width = 2
bar_spacing = 1

# Диапазон частот: без сабвуферного гула и ультразвука
lower_cutoff_freq = 50
higher_cutoff_freq = 16000

# 0 — не засыпать в тишине, чтобы оставались точки нулевой линии
sleep_timer = 0

[output]
# noncurses — без мерцания и разрывов, в отличие от ncurses
method = noncurses
orientation = bottom

# Стерео: низкие частоты в центре, края — каналы
channels = stereo

# Кадр выводится целиком и сразу — без расслоения
synchronized_sync = 1

# Точки на нулевой линии, когда музыки нет
show_idle_bar_heads = 1

[color]
background = '#1a1b26'
foreground = '#c0caf5'

# Градиент по высоте: синий → голубой → фиолетовый → коралловый
gradient = 1
gradient_color_1 = '#7aa2f7'
gradient_color_2 = '#7dcfff'
gradient_color_3 = '#bb9af7'
gradient_color_4 = '#f7768e'

[smoothing]
# 0 — дёргается, 100 — «желе»; 50 — быстрый подъём и плавный спад
noise_reduction = 50
