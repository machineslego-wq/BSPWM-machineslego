/* ==========================================================
   Rofi — конфиг в стиле Tokyo Night
   ==========================================================
   Что это: единый конфиг для лаунчера приложений (drun),
            запуска команд (run) и переключения окон (window).
   Палитра: Tokyo Night (согласована с Polybar, Dunst, Picom).
   Формат:  .rasi (CSS-подобный синтаксис, но НЕ CSS).
   ========================================================== */


/* ==========================================================
   1. КОНФИГУРАЦИЯ — поведение, а не внешний вид
   ==========================================================
   Здесь задаются технические параметры Rofi: какие режимы
   доступны, какой терминал использовать, шрифт по умолчанию
   и т.д. Это НЕ стилизация — их место в секции `configuration`.
   ========================================================== */
configuration {
    /* Список доступных режимов. Порядок = порядок в переключателе
       (Ctrl+Tab внутри Rofi). -show drun / -show window выбирают
       нужный режим при запуске. */
    modi: "drun,run,window";

    /* Показывать иконки приложений в списке.
       Работает только для drun и window (у run иконок нет). */
    show-icons: true;

    /* Тема иконок. Papirus-Dark — чтобы иконки были в тёмном стиле
       и не выбивались из палитры. */
    icon-theme: "Papirus-Dark";

    /* Терминал для режима `run` (когда Rofi запускает команды
       с флагом `-terminal`). У нас используется редко, но
       пусть будет alacritty — на случай `rofi -show run`. */
    terminal: "alacritty";

    /* Основной шрифт. JetBrainsMono Nerd Font обязателен —
       без него иконки не отрисуются (покажутся квадратики). */
    font: "JetBrainsMono Nerd Font 11";

    /* Формат отображения имени приложения в drun.
       {name} — только название. Альтернативы: {generic_name},
       {categories}, {comment}. Для минимализма — {name}. */
    drun-display-format: "{name}";
}


/* ==========================================================
   2. ПАЛИТРА — переменные цветов
   ==========================================================
   Определяются один раз и используются через @имя по всему
   файлу. Если захочешь перекрасить Rofi под другую тему —
   меняешь ТОЛЬКО этот блок, остальное подхватится само.
   ========================================================== */
* {
    bg:         #1a1b26;   /* Основной фон окна и элементов */
    bg-alt:     #24283b;   /* Фон поля ввода (чуть светлее) */
    bg-hover:   #2f334d;   /* Фон при наведении (зарезервирован, не используется) */
    fg:         #c0caf5;   /* Основной текст */
    fg-dim:     #565f89;   /* Приглушённый текст (placeholder в поле ввода) */
    accent:     #7aa2f7;   /* Акцент — синий (фокус, выбранный элемент) */
    accent-2:   #bb9af7;   /* Второй акцент — фиолетовый (активные/срочные) */
    urgent:     #f7768e;   /* Красный — для срочных элементов */
}


/* ==========================================================
   3. ОКНО — внешний контейнер
   ==========================================================
   Это само всплывающее окно Rofi (рамка, фон, скругления).
   ========================================================== */
window {
    width: 42%;                /* Ширина от ширины экрана. На 1366px = ~573px */
    border: 0px;               /* Толщина рамки. 0 = без рамки (чистый вид) */
    border-color: @accent;     /* Цвет рамки — не используется при border: 0 */
    border-radius: 0px;        /* Квадратные углы (TUI-стиль) */
    background-color: @bg;     /* Основной фон */
}

/* Контейнер внутри окна: отступы от краёв окна до содержимого */
mainbox {
    padding: 12px;             /* Отступ по всем сторонам */
    background-color: @bg;     /* Не прозрачный — чтобы не просвечивало */
}


/* ==========================================================
   4. ПОЛЕ ВВОДА (inputbar)
   ==========================================================
   Строка поиска сверху: prompt (значок) + entry (текст).
   ========================================================== */
inputbar {
    padding: 10px 12px;              /* Отступы: сверху/снизу 10, слева/справа 12 */
    background-color: @bg-alt;       /* Фон чуть светлее основного — выделяется */
    border-radius: 0px;              /* Квадратное поле ввода (TUI-стиль) */
    border: 0px;                     /* Без рамки */
    children: [ prompt, entry ];     /* Порядок элементов: сначала значок, потом текст */
}

/* Prompt — значок/подсказка слева от поля ввода */
prompt {
    color: @accent;            /* Синий акцент */
    padding: 0 8px 0 0;        /* Отступ справа 8px (между значком и текстом) */
}

/* Entry — сама строка, куда вводится текст */
entry {
    color: @fg;                            /* Основной текст */
    placeholder: "Поиск...";               /* Текст-подсказка, когда поле пустое */
    placeholder-color: @fg-dim;            /* Цвет подсказки (приглушённый) */
}


/* ==========================================================
   5. СПИСОК РЕЗУЛЬТАТОВ (listview)
   ==========================================================
   Прокручиваемый список найденных элементов под полем ввода.
   ========================================================== */
listview {
    lines: 8;                  /* Сколько строк показывать одновременно */
    scrollbar: false;          /* Скрыть скроллбар (прокрутка колесом/стрелками) */
    background-color: @bg;     /* Фон списка */
    padding: 10px 0 0 0;       /* Отступ сверху (10px) от поля ввода */
    columns: 1;                /* Колонок: 1 = список, >1 = сетка (для drun — см. примечание ниже) */
    fixed-height: false;       /* Высота подстраивается под содержимое */
    border: 0px;               /* Без рамки */
}

/* Скроллбар (если включить scrollbar: true выше) */
scrollbar {
    background-color: transparent;   /* Прозрачный фон дорожки */
    border: 0px;
    handle-color: @accent;           /* Ползунок — синий */
    handle-width: 0px;               /* Ширина ползунка (0 = невидим) */
    handle-rounded-corners: false;
    border-radius: 0px;
}


/* ==========================================================
   6. ЭЛЕМЕНТ СПИСКА (element)
   ==========================================================
   Одна строка результата: иконка + текст. Имеет несколько
   «состояний» — normal / urgent / active — и «выделенное»
   состояние (selected), когда на строке курсор.
   ========================================================== */
element {
    padding: 8px 10px;             /* Отступы внутри строки */
    border-radius: 0px;            /* Квадратная строка (TUI-стиль) */
    background-color: @bg;         /* Фон строки */
    text-color: @fg;               /* Цвет текста */
    spacing: 10px;                 /* Расстояние между иконкой и текстом */
    border: 0px;                   /* Без рамки */
}

/* --- Состояние NORMAL (обычный элемент) --- */
element normal.normal,
element alternate.normal {
    background-color: @bg;         /* Фон строки */
    text-color: @fg;               /* Обычный текст */
}

/* --- Состояние URGENT (срочный элемент, например ошибка) --- */
element normal.urgent,
element alternate.urgent {
    background-color: @bg;
    text-color: @urgent;           /* Красный текст */
}

/* --- Состояние ACTIVE (активный элемент, например открытое окно) --- */
element normal.active,
element alternate.active {
    background-color: @bg;
    text-color: @accent-2;         /* Фиолетовый текст */
}

/* --- Состояние SELECTED (курсор на элементе) --- */
element selected.normal {
    background-color: @accent;     /* Синий фон */
    text-color: @bg;               /* Тёмный текст (инверсия) */
}

element selected.urgent {
    background-color: @urgent;     /* Красный фон */
    text-color: @bg;
}

element selected.active {
    background-color: @accent;     /* Синий фон */
    text-color: @bg;
}


/* ==========================================================
   7. ТЕКСТ И ИКОНКИ ВНУТРИ ЭЛЕМЕНТА
   ==========================================================
   Отдельные свойства для текста и иконки. Наследуют цвет
   от `element`, но можно переопределить.
   ========================================================== */
element-text {
    background-color: transparent;   /* Фон прозрачный (виден фон element) */
    text-color: inherit;             /* Наследует цвет от element */
    vertical-align: 0.5;             /* Вертикальное выравнивание текста */
}

element-icon {
    size: 1.4em;                     /* Размер иконки = 1.4 от размера шрифта */
    background-color: transparent;
}

/* Текст внутри ВЫДЕЛЕННОГО элемента — тёмный, чтобы читался на синем фоне */
element selected element-text {
    text-color: @bg;
}