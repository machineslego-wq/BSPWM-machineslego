/* ==========================================================
   Rofi — конфиг в стиле Tokyo Night
   ==========================================================
   Палитра и оформление для лаунчера, окон и запуска команд.
   Скругления и цвета согласованы с Polybar, Dunst и Picom.
   ========================================================== */

configuration {
    /* Режимы работы: drun (приложения), run (команды), window (переключение окон) */
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    terminal: "alacritty";
    font: "JetBrainsMono Nerd Font 11";
    drun-display-format: "{name}";
}


/* ==========================================================
   Палитра Tokyo Night (общие переменные)
   ========================================================== */
* {
    bg:         #1a1b26;   /* Основной фон */
    bg-alt:     #24283b;   /* Фон поля ввода */
    bg-hover:   #2f334d;   /* Фон при наведении (резерв) */
    fg:         #c0caf5;   /* Основной текст */
    fg-dim:     #565f89;   /* Приглушённый текст (placeholder) */
    accent:     #7aa2f7;   /* Акцент — синий */
    accent-2:   #bb9af7;   /* Второй акцент — фиолетовый (secondary) */
    urgent:     #f7768e;   /* Красный для срочного */
}


/* ==========================================================
   Окно и основная раскладка
   ========================================================== */
window {
    width: 42%;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    background-color: @bg;
}

mainbox {
    padding: 12px;
    background-color: @bg;
}


/* ==========================================================
   Поле ввода
   ========================================================== */
inputbar {
    padding: 10px 12px;
    background-color: @bg-alt;
    border-radius: 8px;
    border: 0px; /* ИСПРАВЛЕНО: Убираем зеленую рамку */
    children: [ prompt, entry ];
}

prompt {
    color: @accent;
    padding: 0 8px 0 0;
}

entry {
    color: @fg;
    placeholder: "Поиск...";
    placeholder-color: @fg-dim;
}


/* ==========================================================
   Список результатов
   ========================================================== */
listview {
    lines: 8;
    scrollbar: false;
    background-color: @bg;
    padding: 10px 0 0 0;
    columns: 1;
    fixed-height: false;
    border: 0px;
}

scrollbar {
    background-color: transparent;
    border: 0px;
    handle-color: @accent-2;
    handle-width: 6px;
    handle-rounded-corners: true;
    border-radius: 3px;
}


/* ==========================================================
   Элемент списка (базовая оболочка)
   ========================================================== */
element {
    padding: 8px 10px;
    border-radius: 8px;
    background-color: @bg;
    text-color: @fg;
    spacing: 10px;
    border: 0px; /* Убираем рамки у элементов */
}

/* --- Обычное (невыделенное) состояние --- */
element normal.normal,
element alternate.normal {
    background-color: @bg;
    text-color: @fg;
}

element normal.urgent,
element alternate.urgent {
    background-color: @bg;
    text-color: @urgent;
}

element normal.active,
element alternate.active {
    background-color: @bg;
    text-color: @accent-2;
}

/* --- Выделенное (курсор) состояние --- */
element selected.normal {
    background-color: @accent;
    text-color: @bg;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @bg;
}

element selected.active {
    background-color: @accent;
    text-color: @bg;
}


/* ==========================================================
   Текст и иконки внутри элемента
   ========================================================== */
element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 1.4em;
    background-color: transparent;
}

element selected element-text {
    text-color: @bg;
}