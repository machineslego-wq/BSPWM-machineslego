#!/bin/sh

# =====================================================================
#                        --- Автозапуск ---
# =====================================================================

# Запуск демона клавиш SXHKD
pgrep -x sxhkd > /dev/null || sxhkd &

# Уведомление-подсказка при запуске (задержка 3 сек, чтобы Dunst успел загрузиться)
(sleep 3 && notify-send -u low -t 8000 -i input-keyboard "Подсказка" "Нажмите Super + /, чтобы открыть меню горячих клавиш") &

# Композитор
picom --config ~/.config/picom/picom.conf &

# Аплет блютуза (невозможно ничем заменить без геморроя)
blueman-applet &

# Запуск polybar
~/.config/polybar/launch.sh &

# =====================================================================
#                          --- Фиксы ---
# =====================================================================

# Фикс для курсора крестика на рабочем столе
xsetroot -cursor_name left_ptr &

# Убить IBUS
(sleep 3 && pkill -x ibus-x11) &

# Убиваем демоны GNOME, которые могут перехватывать клавиши
pkill -x gsd-media-keys &

# Принудительная установка раскладки с задержкой 1 сек (чтобы GDM не перебил)
(sleep 3 && setxkbmap -layout "us,ru" -option "grp:caps_toggle") &

# =====================================================================
#                      --- Остальной конфиг ---
# =====================================================================

# Обои
# feh --bg-fill ~/BSPWM-machineslego/wallpapers/anime-girl-with-big-blue-eyes-and-blue-hair-wallpaper-1920x1080.jpg &
feh --bg-fill ~/BSPWM-machineslego/wallpapers/tokyo-night-girl.jpg &

# Фокус следует за указателем мыши
bspc config focus_follows_pointer true

# Отступ под Polybar
bspc config top_padding    36
bspc config bottom_padding 0

# При необходимости дописать: VIII IX X
# для добавления раб. пространтств 
bspc monitor -d I II III IV V VI VII VIII IX X

# Автоматически добавлять столы на новые мониторы при подключении
bspc config remove_disabled_monitors true
bspc config remove_unplugged_monitors true

# Рамки и отступы и прочие конфигурации
bspc config border_width         2
bspc config window_gap          4

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# Правила для приложений
# bspc rule -a Gimp desktop='^8' state=floating follow=on
# bspc rule -a Chromium desktop='^2'
# bspc rule -a mplayer2 state=floating
# bspc rule -a Kupfer.py focus=on
# bspc rule -a Screenkey manage=off

# Цвет рамки неактивного окна (приглушённый серо-синий из Tokyo Night)
bspc config normal_border_color "#414868"

# Цвет рамки активного (сфокусированного) окна (яркий синий из Tokyo Night)
bspc config focused_border_color "#7aa2f7"

# Цвет обратной связи при изменении размера (можно оставить таким же)
bspc config presel_feedback_color "#bb9af7"
