#!/bin/bash
# =====================================================================
# bspwmrc — Автозапуск и настройка BSPWM-machineslego
# =====================================================================

# =====================================================================
#                       --- АВТОЗАПУСК ---
# =====================================================================

# Демон горячих клавиш (SXHKD). Не запускаем второй экземпляр.
pgrep -x sxhkd > /dev/null || sxhkd &

# Уведомление-подсказка при старте.
# Задержка 3 секунды нужна, чтобы Dunst успел загрузиться и принять уведомление.
(sleep 3 && notify-send -u low -t 8000 -i input-keyboard "Подсказка" "Нажмите Super + /, чтобы открыть меню горячих клавиш") &

# Композитор (тени, скругления, размытие — если включено в конфиге)
picom --config "$HOME/.config/picom/picom.conf" &

# Аплет Bluetooth.
# Оставлен, так как полноценной замены для управления BT в трее без лишней боли нет.
blueman-applet &

# Запуск панели Polybar
"$HOME/.config/polybar/launch.sh" &


# =====================================================================
#                         --- ФИКСЫ ---
# =====================================================================

# Установка стандартного курсора (стрелка) вместо "крестика" на пустом рабочем столе.
xsetroot -cursor_name left_ptr &

# Отключение IBUS (если он установлен и мешает работе раскладки в BSPWM).
# Задержка, чтобы дать ему время запуститься, если он стартует из автозагрузки системы.
(sleep 3 && pkill -x ibus-x11) &

# Убиваем демоны GNOME, которые могут перехватывать мультимедийные клавиши.
pkill -x gsd-media-keys &

# Принудительная установка раскладки (US, RU) с переключением по Caps Lock.
# Задержка нужна, чтобы GDM или другие системные сервисы не перебили настройку.
(sleep 3 && setxkbmap -layout "us,ru" -option "grp:caps_toggle") &


# =====================================================================
#                      --- КОНФИГУРАЦИЯ ---
# =====================================================================

# =====================================================================
#                          --- ОБОИ ---
# =====================================================================
if [ "$(hostname)" = "lamer-deb" ]; then
    # На ПК: горизонтальные обои на основной монитор, вертикальные — на второй
    feh --output DisplayPort-1 --bg-fill "$HOME/BSPWM-machineslego/wallpapers/tokyo-night-girl-landscape.jpg" \
        --output HDMI-A-3 --bg-fill "$HOME/BSPWM-machineslego/wallpapers/tokyo-night-girl-portrait.jpg" &
else
    # На ноутбуках: только горизонтальные на весь экран
    feh --bg-fill "$HOME/BSPWM-machineslego/wallpapers/tokyo-night-girl-landscape.jpg" &
fi

# Фокус окна следует за указателем мыши.
bspc config focus_follows_pointer true

# Отступы под панель Polybar (сверху).
bspc config top_padding    36
bspc config bottom_padding 0

# =====================================================================
#                  --- НАСТРОЙКА МОНИТОРОВ ---
# =====================================================================
# ПК: DP-1 (основной, столы I-IX), HDMI (слева, стол X).
# Ноутбуки: фолбэк — все 10 столов на одном экране.
if [ "$(hostname)" = "lamer-deb" ]; then
    xrandr --output DisplayPort-1 --primary --mode 1920x1080 --rate 144.00
    xrandr --output HDMI-A-3 --auto --rotate right --left-of DisplayPort-1
    sleep 0.5
    bspc wm -O HDMI-A-3 DisplayPort-1
    bspc monitor DisplayPort-1 -d I II III IV V VI VII VIII IX
    bspc monitor HDMI-A-3 -d X
    bspc config -m HDMI-A-3 top_padding 0
else
    bspc monitor -d I II III IV V VI VII VIII IX X
fi
# =====================================================================

# Автоматическое удаление отключенных мониторов и столов на них.
bspc config remove_disabled_monitors true
bspc config remove_unplugged_monitors true

# --- Геометрия и отступы окон ---
bspc config border_width         2
bspc config window_gap           4

# --- Поведение при тайлинге ---
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# --- Правила для приложений (примеры) ---
# bspc rule -a Gimp desktop='^8' state=floating follow=on
# bspc rule -a Chromium desktop='^2'
# bspc rule -a mplayer2 state=floating
# bspc rule -a Kupfer.py focus=on
# bspc rule -a Screenkey manage=off

# --- Цвета рамок окон (Tokyo Night) ---
bspc config normal_border_color "#414868"
bspc config focused_border_color "#7aa2f7"
bspc config presel_feedback_color "#bb9af7"