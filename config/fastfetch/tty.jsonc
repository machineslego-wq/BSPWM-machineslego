{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "cyan",
      "title": "magenta",
      "output": "default"
    },
    "key": {
      "type": "string",
      "width": 16
    }
  },
  "modules": [
    "title",
    "break",
    { "type": "custom", "format": "------- SYSTEM -------" },
    "os",
    "kernel",
    "packages",
    "break",
    { "type": "custom", "format": "------- DESKTOP ------" },
    "wm",
    "shell",
    "terminal",
    "display",
    "break",
    { "type": "custom", "format": "------ HARDWARE ------" },
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    { "type": "custom", "format": "------- PALETTE ------" },
    "colors"
  ]
}