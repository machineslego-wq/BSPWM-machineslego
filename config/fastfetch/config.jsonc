{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "type": "both",
      "width": 16,
      "paddingLeft": 1
    },
    "color": {
      "keys": "38;2;122;162;247",
      "title": "38;2;187;154;247",
      "output": "38;2;192;202;245"
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "█",
        "total": "░"
      },
      "color": {
        "elapsed": "38;2;122;162;247",
        "total": "38;2;86;95;137"
      }
    },
    "percent": {
      "color": {
        "green": "38;2;158;206;106",
        "yellow": "38;2;224;175;104",
        "red": "38;2;247;118;142"
      }
    }
  },
  "modules": [
    "title",
    "separator",

    {
      "type": "custom",
      "format": "╭─ СИСТЕМА ────────────────────────────────────────╮",
      "outputColor": "38;2;122;162;247"
    },
    { "type": "os",       "key": "│ OS" },
    { "type": "host",     "key": "│ Хост" },
    { "type": "kernel",   "key": "│ Ядро" },
    { "type": "uptime",   "key": "│ Аптайм" },
    { "type": "packages", "key": "│ Пакеты" },
    { "type": "shell",    "key": "│ Оболочка" },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────╯",
      "outputColor": "38;2;122;162;247"
    },

    "break",

    {
      "type": "custom",
      "format": "╭─ ОБОРУДОВАНИЕ ───────────────────────────────────╮",
      "outputColor": "38;2;122;162;247"
    },
    { "type": "cpu",    "key": "│ CPU" },
    { "type": "gpu",    "key": "│ GPU" },
    { "type": "memory", "key": "│ Память" },
    { "type": "disk",   "key": "│ Диск" },
    { "type": "battery","key": "│ Батарея" },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────╯",
      "outputColor": "38;2;122;162;247"
    },

    "break",

    {
      "type": "custom",
      "format": "╭─ ОКРУЖЕНИЕ ──────────────────────────────────────╮",
      "outputColor": "38;2;122;162;247"
    },
    { "type": "display", "key": "│ Дисплей" },
    { "type": "wm",      "key": "│ WM" },
    { "type": "terminal","key": "│ Терминал" },
    { "type": "locale",  "key": "│ Локаль" },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────╯",
      "outputColor": "38;2;122;162;247"
    },

    "break",

    {
      "type": "custom",
      "format": "╭─ СЕТЬ ──────────────────────────────────────────╮",
      "outputColor": "38;2;122;162;247"
    },
    { "type": "localip", "key": "│ IP" },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────╯",
      "outputColor": "38;2;122;162;247"
    },

    "break",

    "colors"
  ]
}