# ==============================================================================
# SXHKD — Горячие клавиши для BSPWM-machineslego
# ==============================================================================
# Формат: 
#   <сочетание клавиш>
#       <команда для выполнения>
# Отступ команды — 4 пробела.
# ==============================================================================


# ==============================================================================
# СИСТЕМНЫЕ И НЕЗАВИСИМЫЕ ОТ WM
# ==============================================================================

# Помощь (Super + /)
super + slash
    ~/.config/sxhkd/scripts/cheatsheet.sh

# Перезапуск ВСЕГО (SXHKD + BSPWM + Polybar + Dunst + Picom + Аплеты) (Super + Alt + Shift + R)
super + alt + shift + r
    pkill -USR1 -x sxhkd; \
    pkill -x polybar; \
    pkill -x picom; \
    pkill -x dunst; \
    pkill -x blueman-applet; \
    pkill -x xss-lock; \
    pkill -x lxpolkit; \
    pkill -x copyq; \
    bspc wm -r

# Меню питания (Super + Shift + Q)
super + shift + q
    ~/.config/sxhkd/scripts/powermenu.sh

# Заблокировать экран (Super + Alt + L)
super + alt + l
    i3lock-fancy -p

# Перезагрузить конфиг SXHKD (Super + Escape)
super + Escape
    pkill -USR1 -x sxhkd

# Датчики через терминал (Super + X)
super + x
    alacritty -e watch -n 1 sensors

# Выбор режима питания (Super + Alt + P)
super + alt + p
    ~/.config/polybar/scripts/power-profile.sh --menu &

# Управление Wi-Fi (Super + Alt + N)
super + alt + n
    ~/.config/sxhkd/scripts/wifi.sh

# История буфера обмена (CopyQ) — всплывающее меню у курсора
super + ctrl + v
    copyq menu

# История уведомлений Dunst (Super + Alt + H)
super + alt + h
    ~/.config/sxhkd/scripts/notify-history.sh

# ==============================================================================
# ЗАПУСК ПРИЛОЖЕНИЙ (Быстрый доступ)
# ==============================================================================

# Терминал Alacritty (Super + Return)
super + Return
    alacritty

# Файловый менеджер Thunar (Super + E)
super + e
    thunar

# Браузер Firefox (Super + B)
super + b
    firefox

# Редактор VS Code (Super + V) 
super + v
    code

# Микшер звука (Super + A)
super + a
    pavucontrol

# Лаунчер Rofi (Super + D)
super + d
    rofi -show drun -show-icons

# TG WS Proxy + Telegram-flatpak (Super + Alt + T)
super + alt + t
    tg-ws-proxy & sleep 1 && flatpak run org.telegram.desktop &

# Батарея: подробности в Rofi (Super + Alt + B)
super + alt + b
    ~/.config/sxhkd/scripts/battery.sh

# ==============================================================================
# МУЛЬТИМЕДИА И СКРИНШОТЫ
# ==============================================================================

# Скриншот: весь экран + буфер (Super + F1)
super + F1
    bash -c 'FILE="$HOME/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"; maim "$FILE" && xclip -selection clipboard -t image/png -i "$FILE" && notify-send -u low -t 2000 -i camera-photo -a "Screenshot" "Скриншот" "Весь экран → буфер"'

# Скриншот: активное окно + буфер (Super + F2)
super + F2
    bash -c 'FILE="$HOME/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"; maim -i $(xdotool getactivewindow) "$FILE" && xclip -selection clipboard -t image/png -i "$FILE" && notify-send -u low -t 2000 -i camera-photo -a "Screenshot" "Скриншот" "Активное окно → буфер"'

# Скриншот: выделенная область + буфер (Super + Shift + S)
super + shift + s
    bash -c 'FILE="$HOME/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"; maim -s "$FILE" && xclip -selection clipboard -t image/png -i "$FILE" && notify-send -u low -t 2000 -i camera-photo -a "Screenshot" "Скриншот" "Область → буфер"'

# Скриншот: весь экран с задержкой 3с (Super + F3)
super + F3
    bash -c 'FILE="$HOME/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"; maim -d 3 "$FILE" && xclip -selection clipboard -t image/png -i "$FILE" && notify-send -u low -t 2000 -i camera-photo -a "Screenshot" "Скриншот" "Экран (3с) → буфер"'

# Яркость: +5% (Fn + Brightness Up)
XF86MonBrightnessUp
    brightnessctl set +5%

# Яркость: -5% (Fn + Brightness Down)
XF86MonBrightnessDown
    brightnessctl set 5%-

# Громкость: +5% (Fn + Vol Up)
XF86AudioRaiseVolume
    ~/.config/sxhkd/scripts/volume.sh up

# Громкость: -5% (Fn + Vol Down)
XF86AudioLowerVolume
    ~/.config/sxhkd/scripts/volume.sh down

# Громкость: Mute (Fn + Vol Mute)
XF86AudioMute
    ~/.config/sxhkd/scripts/volume.sh mute


# ==============================================================================
# БАЗОВОЕ УПРАВЛЕНИЕ ОКНАМИ И ФОКУС
# ==============================================================================

# Фокус на окно (Super + Стрелки)
super + {Left,Down,Up,Right}
    bspc node -f {west,south,north,east}

# Перемещение окна (свап с соседом)
super + shift + {Left,Down,Up,Right}
    bspc node -s {west,south,north,east}

# Перемещение плавающего окна — стандартные Vim-keys
# H = влево, J = вниз, K = вверх, L = вправо
# (для тайловых окон используй Super+Shift+Стрелки — свап)
super + {h,j,k,l}
    bspc node -v {-20 0,0 20,0 -20,20 0}

# Предыдущее окно (Super + Tab / Super + `)
super + {grave,Tab}
    bspc {node,desktop} -f last

# Поиск по всем открытым окнам (Alt + Tab)
alt + Tab
    rofi -show window -show-icons

# Следующее/Предыдущее окно (Super + C / Super + Shift + C)
super + {_,shift + }c
    bspc node -f {next,prev}.local.!hidden.window

# Следующий/Предыдущий стол (Super + [ / Super + ])
super + bracket{left,right}
    bspc desktop -f {prev,next}.local

# История фокуса: назад/вперед (Super + O / Super + I)
super + {o,i}
    bspc wm -h off; \
    bspc node {older,newer} -f; \
    bspc wm -h on

# Переход по дереву: Родитель/Сосед/1-й/2-й (Super + P/B/,/.)
super + {p,b,comma,period}
    bspc node -f @{parent,brother,first,second}

# Переключить стол / Перенести окно (Super + 1..0 / Super + Shift + 1..0)
super + {_,shift + }{1-9,0}
    bspc {desktop -f,node -d} {I,II,III,IV,V,VI,VII,VIII,IX,X}


# ==============================================================================
# РЕЖИМЫ, СОСТОЯНИЯ И ТАЙЛИНГ
# ==============================================================================

# Закрыть / Убить процесс (Super + W / Super + Shift + W)
super + {_,shift + }w
    bspc node -{c,k}

# Режим: Тайл/Псевдо/Флоат/Фулскрин (Super + T/Shift+T/S/F)
super + {t,shift + t,s,f}
    bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# Режим Monocle (Super + M)
super + m
    bspc desktop -l next

# Отправить помеченное в Preselect (Super + Y)
super + y
    bspc node newest.marked.local -n newest.!automatic.local

# Поменять с самым большим окном (Super + G)
super + g
    bspc node -s biggest.window

# Флаги: Marked/Locked/Sticky/Private (Super + Ctrl + M/X/Y/Z)
super + ctrl + {m,x,y,z}
    bspc node -g {marked,locked,sticky,private}

# Выход / Перезапуск BSPWM (Super + Alt + Q / R)
super + alt + {q,r}
    bspc {quit,wm -r}


# ==============================================================================
# РАЗМЕРЫ, PRESELECT И RESIZE
# ==============================================================================

# Preselect: направление (Super + Ctrl + Стрелки)
super + ctrl + {Left,Down,Up,Right}
    bspc node -p {west,south,north,east}

# Preselect: пропорция (Super + Ctrl + 1..9)
super + ctrl + {1-9}
    bspc node -o 0.{1-9}

# Preselect: отменить для окна (Super + Ctrl + Space)
super + ctrl + space
    bspc node -p cancel

# Preselect: отменить для стола (Super + Ctrl + Shift + Space)
super + ctrl + shift + space
    bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

# Изменить размер: растянуть (Super + Alt + Стрелки)
super + alt + {Left,Down,Up,Right}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Изменить размер: сжать (Super + Alt + Shift + Стрелки)
super + alt + shift + {Left,Down,Up,Right}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}