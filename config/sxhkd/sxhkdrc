# ==========================================
# СИСТЕМНЫЕ И НЕЗАВИСИМЫЕ ОТ WM
# ==========================================

# Показать шпаргалку (Помощь) по клавишам
super + slash
    ~/.config/sxhkd/scripts/autocheatsheet.sh

# BSPWM: перезапустить SXHKD и WM (полный рестарт)
super + alt + shift + r
    pkill -USR1 -x sxhkd; bspc wm -r

# Выход из аккаунта (Logout) с подтверждением
super + shift + l
    ~/.config/sxhkd/scripts/powermenu.sh logout

# Выключение компьютера (Shutdown) с подтверждением
super + shift + p
    ~/.config/sxhkd/scripts/powermenu.sh poweroff

# Перезагрузка компьютера (Reboot) с подтверждением
super + shift + r
    ~/.config/sxhkd/scripts/powermenu.sh reboot

# Заблокировать экран (Lockscreen)
super + l
    i3lock-fancy -p

# SXHKD: перезагрузить конфиг (без рестарта WM)
super + Escape
    pkill -USR1 -x sxhkd

# Запустить терминал (Alacritty)
super + Return
    alacritty

# Запустить лаунчер приложений (Rofi)
super + d
    rofi -show drun -show-icons

# Микшер звука (Pavucontrol) для смены наушников/колонок
super + a
    pavucontrol

# Мониторинг температур (CPU/GPU/Диски) в Rofi
super + x
    ~/.config/sxhkd/scripts/sensors.sh

# ==========================================
# МУЛЬТИМЕДИА И СКРИНШОТЫ
# ==========================================

# Скриншот: весь экран (с копированием в буфер)
Print
    scrot -e 'xclip -selection clipboard -t image/png -i $f' ~/Изображения/Screenshots/%Y-%m-%d_%H-%M-%S.png

# Скриншот: активное окно (с копированием в буфер)
shift + Print
    scrot -u -e 'xclip -selection clipboard -t image/png -i $f' ~/Изображения/Screenshots/%Y-%m-%d_%H-%M-%S.png

# Скриншот: выделенная область (с копированием в буфер)
super + shift + s
    scrot -s -e 'xclip -selection clipboard -t image/png -i $f' ~/Изображения/Screenshots/%Y-%m-%d_%H-%M-%S.png

# Скриншот: весь экран с задержкой 3с (для меню)
super + Print
    scrot -d 3 -e 'xclip -selection clipboard -t image/png -i $f' ~/Изображения/Screenshots/%Y-%m-%d_%H-%M-%S.png

# Яркость экрана: увеличить (+5%)
XF86MonBrightnessUp
    brightnessctl set +5%

# Яркость экрана: уменьшить (-5%)
XF86MonBrightnessDown
    brightnessctl set 5%-

# Громкость звука: увеличить (+5%)
XF86AudioRaiseVolume
    ~/.config/sxhkd/scripts/volume.sh up

# Громкость звука: уменьшить (-5%)
XF86AudioLowerVolume
    ~/.config/sxhkd/scripts/volume.sh down

# Громкость звука: Mute (выключить/включить)
XF86AudioMute
    ~/.config/sxhkd/scripts/volume.sh mute

# ==========================================
# БАЗОВОЕ УПРАВЛЕНИЕ ОКНАМИ И ФОКУС
# ==========================================

# Окно: смена фокуса (стрелки)
super + {Left,Down,Up,Right}
    bspc node -f {west,south,north,east}

# Окно: смена фокуса и перемещение (Shift + стрелки)
super + {_,shift + }{Left,Down,Up,Right}
    bspc node -{f,s} {west,south,north,east}

# Окно плавающее: переместить (стрелки)
super + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}

# Окно: переключиться на предыдущее (аналог Alt+Tab)
super + {grave,Tab}
    bspc {node,desktop} -f last

# Окно: следующее/предыдущее на рабочем столе
super + {_,shift + }c
    bspc node -f {next,prev}.local.!hidden.window

# Рабочий стол: следующий/предыдущий
super + bracket{left,right}
    bspc desktop -f {prev,next}.local

# Фокус: история переходов (назад/вперед)
super + {o,i}
    bspc wm -h off; \
    bspc node {older,newer} -f; \
    bspc wm -h on

# Фокус: переход по дереву (Родитель/Сосед/Первый/Второй)
super + {p,b,comma,period}
    bspc node -f @{parent,brother,first,second}

# Рабочий стол: переключить / перенести окно (1-9, 0)
super + {_,shift + }{1-9,0}
    bspc {desktop -f,node -d} '^{1-9,10}'

# ==========================================
# РЕЖИМЫ, СОСТОЯНИЯ И ТАЙЛИНГ
# ==========================================

# Окно: закрыть / убить процесс (w / Shift+w)
super + {_,shift + }w
    bspc node -{c,k}

# Окно: режим (Тайл / Псевдо / Плавающее / Fullscreen)
super + {t,shift + t,s,f}
    bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# Раскладка: переключить на Monocle (стопка)
super + m
    bspc desktop -l next

# Окно: отправить помеченное в preselected (y)
super + y
    bspc node newest.marked.local -n newest.!automatic.local

# Окно: поменять местами с самым большим (g)
super + g
    bspc node -s biggest.window

# Окно: флаги (Marked / Locked / Sticky / Private)
super + ctrl + {m,x,y,z}
    bspc node -g {marked,locked,sticky,private}

# BSPWM: выход (Quit) / перезапуск (Restart)
super + alt + {q,r}
    bspc {quit,wm -r}

# ==========================================
# РАЗМЕРЫ, PRESELECT И RESIZE
# ==========================================

# Preselect: задать направление (куда откроется новое окно)
super + ctrl + {Left,Down,Up,Right}
    bspc node -p {west,south,north,east}

# Preselect: задать пропорцию (Ctrl + 1-9)
super + ctrl + {1-9}
    bspc node -o 0.{1-9}

# Preselect: отменить для текущего окна (Space)
super + ctrl + space
    bspc node -p cancel

# Preselect: отменить для всего стола (Ctrl+Shift+Space)
super + ctrl + shift + space
    bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

# Размер окна: растянуть (Alt + стрелки)
super + alt + {Left,Down,Up,Right}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Размер окна: сжать (Alt+Shift + стрелки)
super + alt + shift + {Left,Down,Up,Right}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}