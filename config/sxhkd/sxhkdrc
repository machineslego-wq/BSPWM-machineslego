# ==========================================
# СИСТЕМНЫЕ И НЕЗАВИСИМЫЕ ОТ WM
# ==========================================

# Показать шпаргалку по клавишам
super + slash
    ~/.config/polybar/scripts/autocheatsheet.sh

# Перезапустить SXHKD и BSPWM
super + alt + shift + r
    pkill -USR1 -x sxhkd; bspc wm -r

# Выйти из аккаунта
super + shift + l
    ~/.config/polybar/scripts/powermenu.sh logout

# Выключить компьютер
super + shift + p
    ~/.config/polybar/scripts/powermenu.sh poweroff

# Перезагрузить компьютер
super + shift + r
    ~/.config/polybar/scripts/powermenu.sh reboot

# Заблокировать экран
super + l
    i3lock-fancy

# Перезагрузить конфиг SXHKD
super + Escape
    pkill -USR1 -x sxhkd

# Терминал (Alacritty)
super + Return
    alacritty

# Лаунчер приложений (Rofi)
super + d
    rofi -show drun -show-icons

# ==========================================
# МУЛЬТИМЕДИА И СКРИНШОТЫ
# ==========================================

# Весь экран + копирование в буфер
Print
    scrot -e 'xclip -selection clipboard -t image/png -i $f' ~/Изображения/Screenshots/%Y-%m-%d_%H-%M-%S.png

# Активное окно + копирование в буфер
shift + Print
    scrot -u -e 'xclip -selection clipboard -t image/png -i $f' ~/Изображения/Screenshots/%Y-%m-%d_%H-%M-%S.png

# Выделенная область + копирование в буфер
super + shift + s
    scrot -s -e 'xclip -selection clipboard -t image/png -i $f' ~/Изображения/Screenshots/%Y-%m-%d_%H-%M-%S.png

# Скриншот с задержкой 3с + буфер
super + Print
    scrot -d 3 -e 'xclip -selection clipboard -t image/png -i $f' ~/Изображения/Screenshots/%Y-%m-%d_%H-%M-%S.png

# Яркость: увеличить
XF86MonBrightnessUp
    brightnessctl set +5%

# Яркость: уменьшить
XF86MonBrightnessDown
    brightnessctl set 5%-

# Громкость: увеличить
XF86AudioRaiseVolume
    ~/.config/polybar/scripts/volume.sh up

# Громкость: уменьшить
XF86AudioLowerVolume
    ~/.config/polybar/scripts/volume.sh down

# Громкость: выключить/включить
XF86AudioMute
    ~/.config/polybar/scripts/volume.sh mute

# ==========================================
# БАЗОВОЕ УПРАВЛЕНИЕ ОКНАМИ И ФОКУС
# ==========================================

# Смена фокуса стрелками
super + {Left,Down,Up,Right}
    bspc node -f {west,south,north,east}

# Смена фокуса и перемещение окон (с Shift)
super + {_,shift + }{Left,Down,Up,Right}
    bspc node -{f,s} {west,south,north,east}

# Перемещение плавающего окна
super + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}

# Переключение на предыдущее окно
super + {grave,Tab}
    bspc {node,desktop} -f last

# Следующее/предыдущее окно на рабочем столе
super + {_,shift + }c
    bspc node -f {next,prev}.local.!hidden.window

# Следующий/предыдущий рабочий стол
super + bracket{left,right}
    bspc desktop -f {prev,next}.local

# История фокуса (назад/вперед)
super + {o,i}
    bspc wm -h off; \
    bspc node {older,newer} -f; \
    bspc wm -h on

# Переход к родителю/соседу/первому/второму окну
super + {p,b,comma,period}
    bspc node -f @{parent,brother,first,second}

# Переключение рабочих столов (1-9, 0)
super + {_,shift + }{1-9,0}
    bspc {desktop -f,node -d} '^{1-9,10}'

# ==========================================
# РЕЖИМЫ, СОСТОЯНИЯ И ТАЙЛИНГ
# ==========================================

# Закрыть / убить окно
super + {_,shift + }w
    bspc node -{c,k}

# Состояние окна (тайл, плавающий, фуллскрин)
super + {t,shift + t,s,f}
    bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# Переключить раскладку (Monocle)
super + m
    bspc desktop -l next

# Отправить помеченное окно в preselected
super + y
    bspc node newest.marked.local -n newest.!automatic.local

# Поменять текущее окно с самым большим
super + g
    bspc node -s biggest.window

# Флаги окна (marked, locked, sticky, private)
super + ctrl + {m,x,y,z}
    bspc node -g {marked,locked,sticky,private}

# Выход / перезапуск BSPWM
super + alt + {q,r}
    bspc {quit,wm -r}

# ==========================================
# РАЗМЕРЫ, PRESELECT И RESIZE
# ==========================================

# Задать направление следующего окна (Preselect)
super + ctrl + {Left,Down,Up,Right}
    bspc node -p {west,south,north,east}

# Задать пропорцию следующего окна (Preselect)
super + ctrl + {1-9}
    bspc node -o 0.{1-9}

# Отменить Preselect для окна
super + ctrl + space
    bspc node -p cancel

# Отменить Preselect для всего стола
super + ctrl + shift + space
    bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

# Изменить размер окна (растянуть)
super + alt + {Left,Down,Up,Right}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Изменить размер окна (сжать)
super + alt + shift + {Left,Down,Up,Right}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}