# ==========================================================
# newt / libnmt-newt — палитра Tokyo Night для nmtui и whiptail
# ==========================================================
# Живёт в репозитории: config/newt -> ~/.config/newt
# Подключается переменными из home/bashrc и config/fish/config.fish:
#   NEWT_COLORS_FILE      — палитра libnewt (nmtui, whiptail)
#   NMT_NEWT_COLORS_FILE  — дополнительные наборы nmtui
#
# Формат строки: компонент, затем цвет текста и цвет фона
# через запятую, затем начало следующей строки. Цвета — имена
# ANSI (black, blue, ..., white, brightblue, ...), поэтому
# реальные оттенки берутся из палитры терминала (Tokyo Night
# в Alacritty и foot). default — фон терминала, без подложки.
# ==========================================================

# --- libnewt: основа ---
root=white,default
border=gray,default
window=white,default
shadow=gray,default
roottext=white,default
label=white,default

# Заголовок и шкалы — акцент
title=brightblue,default
fullscale=brightblue,default
emptyscale=gray,default

# Кнопки. У nmtui все кнопки компактные, а libnewt красит
# компактную кнопку в фокусе цветом button, а без фокуса —
# compactbutton (actbutton для компактных не используется
# при поддержке ANSI-цветов). Поэтому акцентная заливка —
# у button, приглушённая плашка — у compactbutton.
button=black,brightblue
compactbutton=white,gray
actbutton=black,brightblue

# Поля ввода и списки
entry=white,default
disentry=gray,default
textbox=white,default
acttextbox=black,brightblue
checkbox=white,default
actcheckbox=black,brightblue
listbox=white,default
actlistbox=black,brightblue
sellistbox=white,gray
actsellistbox=black,brightblue

# Строка подсказок внизу
helpline=brightcyan,default

# --- libnmt-newt: наборы nmtui ---
# Читаются из NMT_NEWT_COLORS_FILE: имена camelCase, отличные
# от NEWT_COLORS. По умолчанию newt красит их светлым фоном
# lightgray/white — на Tokyo Night это выглядит белыми пятнами.
badLabel=brightred,default
plainLabel=gray,default
disabledButton=gray,default
textboxWithBackground=white,gray
