[Default]
# Путь разворачивается переменными окружения: XDG_PICTURES_DIR выставляет
# sway-screenshot annotate, поэтому скриншоты попадают в тот же каталог, что
# и у grim (системные «Изображения», имя зависит от локали).
save_dir=$XDG_PICTURES_DIR/Screenshots
save_filename_format=screenshot-%Y-%m-%d_%H-%M-%S.png
show_panel=true
line_size=4
text_size=18
text_font=JetBrainsMono Nerd Font 11
paint_mode=brush
early_exit=false
fill_shape=false
