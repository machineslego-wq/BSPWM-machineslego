# ==========================================================
# mako — уведомления для Sway в стиле Dunst
# ==========================================================
# Живёт в репозитории: config/mako -> ~/.config/mako
# Эталон — config/dunst/dunstrc: тот же фон, текст, рамка
# 2 px, ширина 360, прогресс-бар тёмно-синий, иконки выключены,
# критичные уведомления не закрываются. Скругление 2 px.
#
# Отличия Dunst -> mako:
#   offset (10, 44)  -> outer-margin 8 (waybar резервирует место)
#   gap_size 8       -> margin 0 (уведомления разделяет рамка)
#   stack_duplicates -> group-by=app-name,summary
#   history_length   -> max-history
#   frcolor/hlcolor  -> критерии по category (OSD громкости)
#
# Применение: mako перечитывает конфиг по SIGHUP
#   pkill -HUP -x mako
# ==========================================================

# --- Шрифт и текст ---
font=JetBrainsMono Nerd Font 10
markup=1
format=<b>%s</b>\n%b
text-alignment=left

# --- Геометрия ---
# width — как в Dunst, height — максимум (короткие подрезаются).
width=360
height=140

# Отступ от края экрана. Mako — layer-shell поверхность: waybar
# резервирует свою зону, поэтому уведомления встают под панелью,
# а зазор до краёв задаёт outer-margin.
outer-margin=8
# Отступ между соседними уведомлениями: 0, их разделяет рамка.
margin=0
padding=8

# --- Оформление ---
background-color=#1a1b26
text-color=#c0caf5
border-size=2
border-color=#7aa2f7
border-radius=2

# Полоса прогресса (хинт value — громкость и т.п.) — тёмно-синяя,
# как bg-alt. OSD громкости перекрывает её своими критериями ниже.
progress-color=over #1c305b

# Иконки выключены: только текст (как в Dunst).
icons=0

# --- Поведение ---
default-timeout=8000
ignore-timeout=0
max-visible=7
max-history=20
layer=overlay
anchor=top-right

# Стопка одинаковых уведомлений от одного приложения.
group-by=app-name,summary

# Мышь как в Dunst: ЛКМ закрыть, СКМ действие, ПКМ закрыть все.
on-button-left=dismiss
on-button-middle=invoke-default-action
on-button-right=dismiss-all

# --- Уровни важности (цвета и таймауты как в Dunst) ---
[urgency=low]
background-color=#1a1b26
text-color=#c0caf5
border-color=#7aa2f7
default-timeout=5000

[urgency=normal]
background-color=#1a1b26
text-color=#c0caf5
border-color=#7aa2f7
default-timeout=8000

[urgency=critical]
background-color=#1a1b26
text-color=#f7768e
border-color=#f7768e
default-timeout=0

# --- OSD громкости (local/bin/wpctl-volume) ---
# Dunst красит OSD по хинтам frcolor/hlcolor, mako их не понимает.
# Поэтому volume помечает уведомление категорией, а цвета задаются
# критериями, как frame_color и highlight в dunst: border-color —
# рамка, progress-color — заливка по value hint (сама громкость).
# У mako заливка занимает всю высоту уведомления, а не полоску
# снизу, поэтому она идёт с альфой 0x26: видно уровень, но текст
# остаётся на тёмном фоне.
# Секции идут ПОСЛЕ [urgency=*]: там тоже задан border-color, и
# последнее совпадение в файле выигрывает.
[category=volume-mute]
border-color=#565f89
progress-color=over #565f8926

[category=volume-low]
border-color=#7aa2f7
progress-color=over #7aa2f726

[category=volume-mid]
border-color=#e0af68
progress-color=over #e0af6826

[category=volume-high]
border-color=#f7768e
progress-color=over #f7768e26

[category=volume-overflow]
border-color=#ff0000
progress-color=over #ff000026
