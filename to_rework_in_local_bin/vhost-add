#!/bin/bash
# ==========================================================
# vhost-add — Создание виртуального хоста Apache2
# ==========================================================
# Создаёт виртуальный хост Apache2, добавляет запись в /etc/hosts,
# создаёт директорию сайта и тестовую страницу.
# Целевая система: Debian 13 Trixie
# Установка:
#   chmod +x vhost-add.sh
#   ln -sf "$PWD/vhost-add.sh" ~/.local/bin/vhost-add
# ==========================================================

# --- Определение реального пользователя (при запуске через sudo) ---
if [ -n "$SUDO_USER" ]; then
    REAL_USER=$SUDO_USER
    REAL_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
else
    REAL_USER=$USER
    REAL_HOME=$HOME
fi

# --- Цвета ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_message() { echo -e "${2}${1}${NC}"; }

echo "=== Apache2 Virtual Host — Create (Создание виртуального хоста) ==="
sudo -v || { echo "Error: sudo required. (Ошибка: требуются права sudo.)"; exit 1; }
echo ""

# --- Ввод домена ---
read -p "-> Введите название домена (например: mydomain.local): " domain_name
if [ -z "$domain_name" ]; then
    print_message "Ошибка: название домена не может быть пустым." "$RED"
    exit 1
fi
if ! [[ $domain_name =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]]; then
    print_message "Ошибка: неверный формат доменного имени." "$RED"
    exit 1
fi

# --- Пути ---
hosts_file="/etc/hosts"
sites_available_dir="/etc/apache2/sites-available"
document_root="/var/www/html/$domain_name"
vhost_file="$sites_available_dir/$domain_name.conf"

print_message "-> Начинаем настройку домена: $domain_name" "$YELLOW"
echo ""

# 1. /etc/hosts
echo "-> 1. Добавляем запись в /etc/hosts..."
if grep -qE "^[^#]*\b$domain_name\b" "$hosts_file"; then
    print_message "  Запись для $domain_name уже существует" "$YELLOW"
else
    echo "127.0.0.1    $domain_name" | sudo tee -a "$hosts_file" > /dev/null
    print_message "  127.0.0.1  $domain_name  →  $hosts_file" "$GREEN"
fi

# 2. Директория сайта
echo "-> 2. Создаём директорию для сайта..."
if [ ! -d "$document_root" ]; then
    sudo mkdir -p "$document_root"
    sudo chown -R www-data:www-data "$document_root"
    print_message "  Директория $document_root создана" "$GREEN"
else
    print_message "  Директория $document_root уже существует" "$YELLOW"
fi

# 3. Тестовая страница
echo "-> 3. Создаём тестовую страницу..."
sudo tee "$document_root/index.html" > /dev/null << EOF
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to $domain_name</title>
</head>
<body>
    <h1>Добро пожаловать на $domain_name!</h1>
    <p>Это тестовая страница для виртуального хоста.</p>
    <p>Сайт работает корректно!</p>
    <p>Время создания: $(date)</p>
</body>
</html>
EOF
sudo chown www-data:www-data "$document_root/index.html"
print_message "  Тестовая страница создана" "$GREEN"

# 4. Конфиг vhost
echo "-> 4. Создаём конфигурацию виртуального хоста..."
sudo tee "$vhost_file" > /dev/null << EOF
<VirtualHost *:80>
    ServerName $domain_name
    ServerAlias www.$domain_name
    DocumentRoot $document_root

    ErrorLog \${APACHE_LOG_DIR}/${domain_name}_error.log
    CustomLog \${APACHE_LOG_DIR}/${domain_name}_access.log combined

    <Directory $document_root>
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
EOF
print_message "  Конфигурация создана: $vhost_file" "$GREEN"

# 5. Активация
echo "-> 5. Активируем сайт..."
sudo a2ensite "$domain_name.conf" > /dev/null 2>&1

# 6. Проверка и перезагрузка
echo "-> 6. Проверяем конфигурацию Apache..."
if sudo apache2ctl configtest; then
    print_message "  Конфигурация Apache корректна" "$GREEN"
    echo "-> 7. Перезагружаем Apache..."
    sudo systemctl reload apache2
    print_message "  Apache перезагружен" "$GREEN"
else
    print_message "  Ошибка в конфигурации Apache!" "$RED"
    sudo a2dissite "$domain_name.conf" > /dev/null 2>&1
    exit 1
fi

echo ""
print_message "=== Настройка завершена успешно! ===" "$GREEN"
echo ""
echo "  Домен:        $domain_name"
echo "  DocumentRoot: $document_root"
echo "  URL:          http://$domain_name"
echo ""
echo "Удаление: vhost-rm"