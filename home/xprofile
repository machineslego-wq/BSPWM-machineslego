export PATH="$HOME/.local/bin:$PATH"
# KDE-приложения (Dolphin, Okular, Ark) красятся только платформенной темой
# kde: палитру, стиль и иконки она берёт из kdeglobals (схема TokyoNight).
# qt6ct задаёт QPalette, но KF6-виджеты его игнорируют. Если Plasma не
# установлена, остаётся qt6ct с палитрой из config/qt6ct.
if ls /usr/lib/*/qt6/plugins/platformthemes/KDEPlasmaPlatformTheme6.so >/dev/null 2>&1; then
    export QT_QPA_PLATFORMTHEME=kde
else
    export QT_QPA_PLATFORMTHEME=qt6ct
fi
# KDE-приложениям (Dolphin) вне Plasma нужен файл меню: KServiceGroup ищет
# $XDG_MENU_PREFIX + applications.menu, в Debian он есть только как
# plasma-applications.menu. Без префикса список «Открыть с помощью» пуст.
export XDG_MENU_PREFIX=plasma-
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24
# Сброс порталов, оставшихся от предыдущей сессии (GNOME/Sway).
command -v session-cleanup >/dev/null 2>&1 && session-cleanup || true
