# ==========================================================
# .xprofile — Переменные окружения для графической сессии
# ==========================================================
# Этот файл читается Display Manager'ом (например, LightDM) 
# или при логине. Задает базовые темы для GTK-приложений 
# и системного курсора, чтобы они не сбрасывались на дефолтные.
# ==========================================================

# 1. Тема оформления для GTK-приложений (Adwaita-dark)
# Приложения GTK будут использовать темную тему по умолчанию.
export GTK_THEME=Adwaita-dark

# 2. Настройка курсора мыши
# (тема Bibata-Modern-Ice, размер 24)
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24