#!/bin/bash
# ==========================================================
# xinitrc — Запуск графической сессии
# ==========================================================
# Выполняется при старте Xorg (через `startx`).
# Загружает ресурсы X11, задает курсор и запускает BSPWM.
# ==========================================================

# 1. Применяем настройки X11 (шрифты, DPI, цвета из ~/.Xresources)
xrdb -merge "$HOME/.Xresources"

# 2. Настройка курсора мыши
# (тема Bibata-Modern-Amber, размер 24)
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24

# 3. Запуск оконного менеджера
# exec заменяет текущий процесс (оболочку xinit) на BSPWM,
# чтобы при выходе из WM сессия Xorg корректно завершалась.
exec bspwm