# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# don't put duplicate lines or lines starting with space in the history.
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# history length
HISTSIZE=1000
HISTFILESIZE=2000

# check window size
shopt -s checkwinsize

# make less more friendly
#[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Color prompt
force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
        color_prompt=yes
    else
        color_prompt=
    fi
fi

# Detect TTY vs graphical mode based on TERM
is_tty=false
if [[ "$TERM" == "linux" ]]; then
    is_tty=true
fi

# Build prompt dynamically
prompt_command() {
    local exit_code=$?
    local reset="\[\033[0m\]"

    # Colors (Tokyo Night)
    local c_debian="\[\033[38;2;125;207;255m\]"    # #7dcfff
    local c_dir="\[\033[38;2;122;162;247m\]"      # #7aa2f7
    local c_git="\[\033[38;2;187;154;247m\]"      # #bb9af7
    local c_arrow="\[\033[38;2;158;206;106m\]"    # #9ece6a
    [ $exit_code -ne 0 ] && c_arrow="\[\033[38;2;247;118;142m\]"  # red on error

    # Icons based on TTY mode
    if [ "$is_tty" = true ]; then
        # TTY fallback: no icons
        local icon_debian="debian"
        local icon_dir="dir"
        local icon_git="git"
        local sep="|"
        local arrow=">"
    else
        # Graphical mode: Nerd Fonts
        local icon_debian=""
        local icon_dir=""
        local icon_git=""
        local sep="│"
        local arrow="❯"
    fi

    # Debian icon (1 space before)
    local debian=" ${c_debian}${icon_debian}${reset}"

    # Path with icon
    local pwd_short="$PWD"
    local home_len=${#HOME}
    if [[ "$PWD" == "$HOME"* ]]; then
        pwd_short="~${PWD:$home_len}"
    fi
    local path_part="${c_dir}${icon_dir} ${pwd_short}${reset}"

    # Git - only show if in git repo
    local git_part=""
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local branch=$(git branch --show-current 2>/dev/null)
        if [ -z "$branch" ]; then
            branch=$(git rev-parse --short HEAD 2>/dev/null)
        fi
        local dirty=""
        [ -n "$(git status --porcelain 2>/dev/null)" ] && dirty="*"
        git_part="${c_git}${icon_git} ${branch}${dirty}${reset}"
    fi

    # Arrow
    local arrow_part="${c_arrow}${arrow}${reset}"

    if [ "$is_tty" = true ]; then
        # TTY: username@host:path git branch
        PS1="\u@\h:\w"
        [ -n "$branch" ] && PS1="${PS1} ${icon_git} ${branch}${dirty}"
        PS1="${PS1} ${arrow_part} "
    else
        # Graphical mode: debian icon | path | git | arrow
        PS1="${debian} ${sep} ${path_part}"
        [ -n "$git_part" ] && PS1="${PS1} ${sep} ${git_part}"
        PS1="${PS1} ${arrow_part} "
    fi
}

PROMPT_COMMAND=prompt_command

# If this is an xterm set the title
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# ls with eza and icons
if [ -x "$(command -v eza)" ]; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza -la --icons --group-directories-first'
    alias la='eza -la --icons --group-directories-first'
    alias l='eza -l --icons --group-directories-first'
else
    if [ -x /usr/bin/dircolors ]; then
        test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    fi
    alias ls='ls --color=auto'
fi

# Alias definitions
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# completion
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Cargo
. "$HOME/.cargo/env"
